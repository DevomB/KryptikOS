# LF everywhere, whatever core.autocrlf says: a CRLF script fails with
# "bad interpreter".
* text=auto eol=lf

*.sh        text eol=lf
Makefile    text eol=lf
*.env       text eol=lf
*.conf      text eol=lf
*.fragment  text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf

# Binary artifacts must never be normalized.
*.iso    binary
*.img    binary
*.tar.*  binary
*.gz     binary
*.xz     binary
*.sqfs   binary

# Patches are checked against SHA256SUMS byte for byte.
*.patch     -text
