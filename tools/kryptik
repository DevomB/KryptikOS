#!/usr/bin/env bash
# kryptik: the user's command for zones. Fills in kryptikd's paths from
# kryptik.conf and never offers a way past kryptikd's refusals.
#
# When not root and the session's launch service (kryptik-launch) answers,
# zones start through it; otherwise kryptikd runs them directly. There is no
# transfer, clipboard or mount command: from zone 0 those would bypass the
# chrome, where the user approves each move.
set -uo pipefail

PROG="${0##*/}"
CONF="${KRYPTIK_CONF:-/etc/kryptik/kryptik.conf}"

# kryptikd's own defaults; kryptik.conf overrides them, then flags.
ZONES_DIR=/usr/lib/kryptik/zones
ROOTFS=/var/lib/kryptik/zones
WIFI_DIR=/var/lib/kryptik/wifi
UID_BASE=100000
KRYPTIKD="${KRYPTIKD:-kryptikd}"

C_RST=""; C_DIM=""; C_B=""
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RST=$'\033[0m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'
fi

die()  { printf '%s: %s\n' "$PROG" "$1" >&2; exit "${2:-1}"; }
info() { printf '%s%s%s\n' "$C_DIM" "$1" "$C_RST"; }

usage() {
    cat <<USAGE
$PROG — run and manage Kryptik zones

USAGE:
    $PROG list                      zones on this system, and which are running
    $PROG status [NAME]             one zone, or all of them
    $PROG explain NAME              what starting this zone would and would not do
    $PROG shell NAME                an interactive shell inside the zone
    $PROG run NAME -- CMD [ARGS]    one command inside the zone
    $PROG stop NAME [--now]         stop it (--now skips the polite request)
    $PROG gc                        clean up after zones whose manager died
    $PROG doctor                    check this system can run zones at all
    $PROG wifi list                 the Wi-Fi networks the net zone knows
    $PROG wifi add SSID             add one, or change its passphrase (asked
                                    for on the terminal; never an argument)
    $PROG wifi forget SSID          remove one
    $PROG update status             the release running, the newest one known
                                    and how old that news is, what is staged
    $PROG update fetch              ask for the newest release to be fetched
    $PROG update apply              install what has arrived; the next boot
                                    tries it once and falls back if it fails
    $PROG state passphrase          change the passphrase the state partition
                                    asks for at boot (root; the old one first)

OPTIONS:
    --zones DIR           override the zone directory (default: $ZONES_DIR)
    --rootfs DIR          override the zone data directory (default: $ROOTFS)
    --wifi-dir DIR        override where the net zone's Wi-Fi credentials are
                          kept (default: $WIFI_DIR)

CONFIGURATION: $CONF
    zones_dir = /usr/lib/kryptik/zones
    rootfs    = /var/lib/kryptik/zones
    wifi_dir  = /var/lib/kryptik/wifi
    uid_base  = 100000

Every zone runs as an unprivileged host user, in its own user, pid, mount, ipc,
uts and cgroup namespaces, under a seccomp filter and a Landlock policy; a
routed zone reaches the network only through the net zone; an encrypted zone
lives on its own LUKS2 volume and asks for its passphrase when it starts.

As an ordinary user in a desktop session, shell/run/stop go through the
session's launch service (kryptik-launch). Files cross zones only through the
broker, from inside a zone, after you answer the chrome's question; the
clipboard moves only by the chrome's zone 0 gesture (Alt+p, then m<from><to>).
$PROG has no commands for either, on purpose.
USAGE
}

# True when not root and the session's launch service answers. --runtime-dir
# is its cheapest request and fails fast rather than hanging.
LAUNCH="${KRYPTIK_LAUNCH:-kryptik-launch}"
via_launch() {
    [[ "$(id -u)" -ne 0 ]] || return 1
    command -v "$LAUNCH" >/dev/null 2>&1 || return 1
    "$LAUNCH" --runtime-dir >/dev/null 2>&1
}

# --- configuration ----------------------------------------------------------
# Parsed, not sourced: a stray line in the file must not run as the caller.
load_conf() {
    [[ -r "$CONF" ]] || return 0
    local line key val
    while IFS= read -r line; do
        line="${line%%#*}"
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        key="$(printf '%s' "$key" | tr -d '[:space:]')"
        val="$(printf '%s' "$val" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        case "$key" in
            zones_dir) ZONES_DIR="$val" ;;
            rootfs)    ROOTFS="$val" ;;
            wifi_dir)  WIFI_DIR="$val" ;;
            uid_base)  UID_BASE="$val" ;;
            "")        ;;
            *) printf '%s: %s: ignoring unknown setting %s\n' "$PROG" "$CONF" "$key" >&2 ;;
        esac
    done < "$CONF"
}

have_kryptikd() {
    command -v "$KRYPTIKD" >/dev/null 2>&1 || die \
"kryptikd is not on PATH.
    This is the program that actually creates zones; $PROG only arranges its
    arguments. Install it, or set KRYPTIKD=/path/to/kryptikd."
}

# The flags that map a zone to an unprivileged host user. kryptikd takes them
# only as root, and then requires them unless the zone declares its own.
# Sets an array rather than printing for `< <(...)`: process substitution
# needs /dev/fd, which a minimal system may lack.
IDENTITY_ARGS=()
set_identity_args() { # zone name
    IDENTITY_ARGS=()
    [[ "$(id -u)" -eq 0 ]] || return 0

    # kryptikd refuses the flags for a zone with [identity] uid_base. A
    # presence test is enough: kryptikd checks the value itself.
    if grep -qE '^[[:space:]]*uid_base[[:space:]]*=' "$ZONES_DIR/$1.toml" 2>/dev/null; then
        return 0
    fi
    IDENTITY_ARGS=(--zone-uid "$UID_BASE" --zone-gid "$UID_BASE")
}

# The zone list, and separately whether reading it failed.
ZONE_LIST=""
ZONE_LIST_ERR=""
ZONE_LIST_RC=0
load_zone_list() {
    ZONE_LIST_ERR="$("$KRYPTIKD" list --zones "$ZONES_DIR" 2>&1 >/dev/null)"
    ZONE_LIST="$("$KRYPTIKD" list --zones "$ZONES_DIR" 2>/dev/null)"
    ZONE_LIST_RC=$?
}

zone_exists() {
    load_zone_list
    printf '%s\n' "$ZONE_LIST" | grep -qx "$1"
}

# Exit unless NAME is a zone, listing the zones there or why they are unreadable.
require_zone() {
    local name="$1"
    zone_exists "$name" && return 0
    # A failed read is not an empty directory: show kryptikd's error.
    if (( ZONE_LIST_RC != 0 )) || [[ -n "$ZONE_LIST_ERR" ]]; then
        printf '%s: could not read the zones in %s\n\n' "$PROG" "$ZONES_DIR" >&2
        [[ -n "$ZONE_LIST_ERR" ]] && printf '%s\n' "$ZONE_LIST_ERR" | sed 's/^/    /' >&2
        printf '\nThis is not the same as having no zones. Until it is fixed, no zone\n' >&2
        printf 'will start. Try: %s doctor\n' "$PROG" >&2
        exit 1
    fi
    printf '%s: no zone named %s\n\n' "$PROG" "$name" >&2
    if [[ -n "$ZONE_LIST" ]]; then
        printf 'Zones on this system:\n' >&2
        printf '%s\n' "$ZONE_LIST" | sed 's/^/    /' >&2
    else
        printf 'There are no zone definitions in %s.\n' "$ZONES_DIR" >&2
    fi
    exit 1
}

# --- running state ----------------------------------------------------------
# A word, not a colour: it must survive a pipe, a monochrome terminal and a
# screen reader.
running_state() {
    local out
    out="$("$KRYPTIKD" status "$1" 2>/dev/null)" || { printf 'unknown'; return; }
    case "$out" in
        *" running "*|*" running") printf 'RUNNING' ;;
        *stale*)                   printf 'stale' ;;
        *)                         printf 'stopped' ;;
    esac
}

cmd_list() {
    have_kryptikd
    local zones
    zones="$("$KRYPTIKD" list --zones "$ZONES_DIR" 2>&1)" || die \
"could not read zones from $ZONES_DIR
$zones"
    [[ -n "$zones" ]] || { info "no zones are configured in $ZONES_DIR"; return 0; }
    printf '%s%-16s %-8s %s%s\n' "$C_B" "ZONE" "STATE" "DESCRIPTION" "$C_RST"
    local z desc
    while IFS= read -r z; do
        [[ -n "$z" ]] || continue
        desc="$("$KRYPTIKD" show "$z" --zones "$ZONES_DIR" 2>/dev/null \
                | sed -n 's/^description  *//p' | head -1)"
        printf '%-16s %-8s %s\n' "$z" "$(running_state "$z")" "${desc:-}"
    done <<< "$zones"
}

cmd_status() {
    have_kryptikd
    if [[ $# -eq 0 ]]; then
        cmd_list
        return
    fi
    require_zone "$1"
    printf '%-16s %s\n' "$1" "$(running_state "$1")"
    "$KRYPTIKD" status "$1" 2>&1 | sed 's/^/    /'
}

cmd_explain() {
    have_kryptikd
    require_zone "$1"
    "$KRYPTIKD" explain "$1" --zones "$ZONES_DIR"
}

cmd_doctor() {
    have_kryptikd
    printf '%szones:%s     %s\n' "$C_B" "$C_RST" "$ZONES_DIR"
    printf '%sdata:%s      %s\n' "$C_B" "$C_RST" "$ROOTFS"
    printf '%srunning as:%s uid %s%s\n' "$C_B" "$C_RST" "$(id -u)" \
        "$([[ "$(id -u)" -eq 0 ]] && printf ' (zones map to uid %s)' "$UID_BASE")"
    printf '\n'
    "$KRYPTIKD" check --zones "$ZONES_DIR"
}

cmd_gc() { have_kryptikd; "$KRYPTIKD" gc; }

cmd_stop() {
    local name="$1"; shift
    if via_launch; then
        [[ -f "$ZONES_DIR/$name.toml" ]] || die "no zone named $name in $ZONES_DIR"
        "$LAUNCH" --stop "$name"
        return
    fi
    have_kryptikd
    require_zone "$name"
    local state; state="$(running_state "$name")"
    if [[ "$state" == "stopped" ]]; then
        info "zone $name is not running"
        return 0
    fi
    "$KRYPTIKD" stop "$name" "$@"
}

# --- starting ---------------------------------------------------------------

# The one place that runs a zone, for both shell and run.
start_zone() {
    local name="$1"; shift
    if via_launch; then
        [[ -f "$ZONES_DIR/$name.toml" ]] || die "no zone named $name in $ZONES_DIR"
        # --ask reads an encrypted zone's passphrase on this terminal and passes
        # it on a descriptor, never as an argument.
        "$LAUNCH" --ask --no-display "$name" -- "$@"
        local rc=$?
        (( rc == 0 )) || printf '\n%s: %s did not start through the launch service (exit %d).\n' "$PROG" "$name" "$rc" >&2
        return "$rc"
    fi
    have_kryptikd
    require_zone "$name"

    mkdir -p "$ROOTFS" 2>/dev/null || true

    local rc
    set_identity_args "$name"

    # Not captured: a shell needs the terminal, and kryptikd's warnings and
    # refusals must reach the user unchanged.
    "$KRYPTIKD" run "$name" --zones "$ZONES_DIR" \
        --rootfs "$ROOTFS" "${IDENTITY_ARGS[@]}" -- "$@"
    rc=$?
    if (( rc != 0 )); then
        # kryptikd has said what was wrong; add only where to look next.
        printf '\n%s: %s did not start (kryptikd exited %d).\n' "$PROG" "$name" "$rc" >&2
        printf '    %s explain %s    what this zone asks for, and what this build provides\n' \
            "$PROG" "$name" >&2
    fi
    return "$rc"
}

cmd_shell() {
    local name="$1"; shift
    # /bin/sh, not $SHELL: $SHELL is the host's and may not exist in the zone.
    start_zone "$name" /bin/sh -l
}

cmd_run() {
    local name="$1"; shift
    [[ "${1:-}" == "--" ]] && shift
    [[ $# -gt 0 ]] || die "$PROG run NAME -- CMD [ARGS]: no command given"
    start_zone "$name" "$@"
}

# --- the net zone's Wi-Fi networks ------------------------------------------
# kryptikd keeps the credentials in zone 0 and restarts the net zone after a
# change (docs/design/net-zone.md). The passphrase always goes on stdin.

# Read one line into PASSPHRASE: from the terminal with echo off, or a pipe.
PASSPHRASE=""
read_passphrase() { # ssid
    if [[ -t 0 ]]; then
        IFS= read -rs -p "passphrase for $1: " PASSPHRASE
        printf '\n' >&2
    else
        IFS= read -r PASSPHRASE
    fi
    [[ -n "$PASSPHRASE" ]] || die "no passphrase given"
}

cmd_wifi() {
    local sub="${1:-}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
        list)   [[ $# -eq 0 ]] || die "$PROG wifi list takes no argument" 2 ;;
        add|forget) [[ $# -eq 1 ]] || die "$PROG wifi $sub SSID: exactly one SSID" 2 ;;
        *) usage >&2; die "wifi needs a subcommand: list, add SSID or forget SSID" 2 ;;
    esac
    if via_launch; then
        case "$sub" in
            list)   "$LAUNCH" --wifi-list ;;
            add)    read_passphrase "$1"
                    # printf is a builtin, so the passphrase is never in argv.
                    printf '%s\n' "$PASSPHRASE" | "$LAUNCH" --wifi-add "$1" ;;
            forget) "$LAUNCH" --wifi-forget "$1" ;;
        esac
        return
    fi
    have_kryptikd
    case "$sub" in
        list)   "$KRYPTIKD" wifi list --wifi-dir "$WIFI_DIR" ;;
        add)    read_passphrase "$1"
                printf '%s\n' "$PASSPHRASE" | "$KRYPTIKD" wifi add "$1" --wifi-dir "$WIFI_DIR" --zones "$ZONES_DIR" ;;
        forget) "$KRYPTIKD" wifi forget "$1" --wifi-dir "$WIFI_DIR" --zones "$ZONES_DIR" ;;
    esac
}

# Installed systems only: the update state is zone 0's, reached through the
# launch service.
cmd_update() {
    case "${1:-}" in
        status|fetch|apply) [[ $# -eq 1 ]] || die "$PROG update $1 takes no argument" 2 ;;
        *) usage >&2; die "update needs a subcommand: status, fetch or apply" 2 ;;
    esac
    via_launch || die "update goes through the launch service, which is not answering here (an installed Kryptik, as a session user)"
    "$LAUNCH" --update "$1"
}

# cryptsetup asks for the passphrases on the terminal; none pass through here.
cmd_state() {
    [[ "${1:-}" == passphrase && $# -eq 1 ]] || { usage >&2; die "state needs a subcommand: passphrase" 2; }
    [[ $EUID -eq 0 ]] || die "the state passphrase is root's to change"
    local dev; dev="$(sed -n 's/^state_dev=//p' /run/kryptik/boot-identity 2>/dev/null)"
    [[ -b "$dev" ]] || die "this system has no state partition in use"
    exec cryptsetup luksChangeKey "$dev"
}

# --- argument parsing -------------------------------------------------------
load_conf

ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --zones)  ZONES_DIR="${2:?--zones needs a directory}"; shift 2 ;;
        --rootfs) ROOTFS="${2:?--rootfs needs a directory}"; shift 2 ;;
        --wifi-dir) WIFI_DIR="${2:?--wifi-dir needs a directory}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) ARGS+=("$@"); break ;;
        *)  ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

cmd="${1:-}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
    list)    cmd_list "$@" ;;
    status)  cmd_status "$@" ;;
    explain) [[ $# -ge 1 ]] || die "explain needs a zone name"; cmd_explain "$@" ;;
    shell)   [[ $# -ge 1 ]] || die "shell needs a zone name"; cmd_shell "$@" ;;
    run)     [[ $# -ge 1 ]] || die "run needs a zone name"; cmd_run "$@" ;;
    stop)    [[ $# -ge 1 ]] || die "stop needs a zone name"; cmd_stop "$@" ;;
    gc)      cmd_gc ;;
    doctor)  cmd_doctor ;;
    wifi)    cmd_wifi "$@" ;;
    update)  cmd_update "$@" ;;
    state)   cmd_state "$@" ;;
    ""|help) usage ;;
    # Commands users will expect, answered with why they do not exist.
    transfer|copy|clipboard|paste|mount)
        die "\`$cmd\` is not a $PROG command, on purpose.
    A file crosses zones only through the broker socket INSIDE the sending zone
    (the zone verb \`transfer TO NAME\` with the file's descriptor; see
    docs/design/broker.md), and only after you answer the question the chrome shows.
    The clipboard moves only by the chrome's zone 0 gesture: Alt+p, then
    m<from><to>. Nothing in zone 0 can do either for you." 2 ;;
    *) usage >&2; die "unknown command: $cmd" 2 ;;
esac
