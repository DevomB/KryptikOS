#!/usr/bin/env bash
# Kryptik pre-push hook: refuse to push a commit under any other identity, even
# one made past pre-commit (another checkout, a rebase, --no-verify).
# Install with ./tools/install-git-hooks.sh.

set -uo pipefail

# Found relative to this file, as in pre-commit; missing means refuse.
checker="$(dirname "${BASH_SOURCE[0]}")/../check-commit-identity.sh"
if [[ ! -f "$checker" ]]; then
    echo "pre-push: ERROR no identity checker at ${checker}; refusing to push unchecked" >&2
    exit 1
fi
zero="0000000000000000000000000000000000000000"
bad=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue            # deleting a ref

    # A new ref, or a force-push whose old tip is unknown here: check the
    # whole history behind the new tip.
    if [[ "$remote_sha" == "$zero" ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    bash "$checker" "$range" || bad=1
done

if [[ "$bad" -ne 0 ]]; then
    echo >&2
    echo "pre-push: refusing the push. Rewrite the commits named above first:" >&2
    echo "    git rebase <base> --exec 'git commit --amend --no-edit --reset-author'" >&2
    echo "with user.name and user.email set to the permitted identity." >&2
    exit 1
fi

exit 0
