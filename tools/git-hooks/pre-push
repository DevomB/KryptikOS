#!/usr/bin/env bash
# Kryptik pre-push hook.
#
# Install with:  ./tools/install-git-hooks.sh
#
# Nothing leaves this machine under the wrong identity. The pre-commit hook
# stops a bad commit being made here; this stops one made anywhere else (a
# second checkout, a rebase that re-stamped the committer, a --no-verify) from
# reaching GitHub, where the attribution becomes public.

set -uo pipefail

top="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
bad=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue            # deleting a ref

    # A new ref, or a force-push whose old tip is not in this repository:
    # there is no range to speak of, so the whole history behind the new tip
    # is what gets checked. It is a few hundred commits and takes no time.
    if [[ "$remote_sha" == "$zero" ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    "$top/tools/check-commit-identity.sh" "$range" || bad=1
done

if [[ "$bad" -ne 0 ]]; then
    echo >&2
    echo "pre-push: refusing the push. Rewrite the commits named above first:" >&2
    echo "    git rebase <base> --exec 'git commit --amend --no-edit --reset-author'" >&2
    echo "with user.name and user.email set to the permitted identity." >&2
    exit 1
fi

exit 0
