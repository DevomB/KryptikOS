#!/usr/bin/env bash
# Kryptik pre-commit hook: commit identity, exec bits, CRLF and shell syntax.
# Install with ./tools/install-git-hooks.sh.

set -uo pipefail

fail=0

# --- identity -----------------------------------------------------------------
# Checked first: a wrong address hands the commit to another GitHub account.
# The checker is found relative to this file; a missing one refuses.
checker="$(dirname "${BASH_SOURCE[0]}")/../check-commit-identity.sh"
if [[ ! -f "$checker" ]]; then
    echo "pre-commit: ERROR no identity checker at ${checker}; refusing to commit unchecked" >&2
    exit 1
fi
if ! bash "$checker" --pending; then
    exit 1
fi

# --- executable bits --------------------------------------------------------
# NTFS has no exec bit, so a script committed from Windows records 100644 and
# a Linux clone gets "Permission denied": set the bit in the index. Hook files
# and tools/test-*.py suites have no .sh suffix, so they are matched by name;
# git silently ignores a non-executable hook.
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    mode="$(git ls-files -s -- "$f" | awk '{print $1}')"
    if [[ "$mode" == "100644" ]]; then
        echo "pre-commit: setting exec bit on ${f}"
        git update-index --chmod=+x -- "$f"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM \
         | grep -E '^(build/stages/|tools/|compartments/tests/).*\.sh$|^tools/test-[A-Za-z0-9_-]+\.py$|^tools/git-hooks/[A-Za-z][A-Za-z0-9_-]*$' \
         || true)

# build/lib/common.sh is sourced, not executed, and stays 644.

# --- CRLF -------------------------------------------------------------------
# .gitattributes normalises line endings, but `add -f` or an editor can still
# stage CRLF, which gives "bad interpreter: bash^M".
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if git show ":${f}" 2>/dev/null | grep -qU $'\r'; then
        echo "pre-commit: ERROR ${f} contains CRLF; scripts must be LF" >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM \
         | grep -E '\.(sh|rs)$|Makefile' || true)

# --- shell syntax -----------------------------------------------------------
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ -f "$f" ]] || continue
    if ! bash -n "$f" 2>/dev/null; then
        echo "pre-commit: ERROR ${f} has a shell syntax error" >&2
        bash -n "$f" 2>&1 | sed 's/^/    /' >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)

if [[ "$fail" -ne 0 ]]; then
    echo >&2
    echo "pre-commit: refusing the commit. Fix the above, or use --no-verify" >&2
    echo "if you genuinely intend it." >&2
    exit 1
fi

exit 0
