#!/usr/bin/env bash
# Kryptik pre-commit hook.
#
# Install with:  ./tools/install-git-hooks.sh
#
# Catches the two Windows-authoring mistakes that have each broken a clone in
# this repository already, before they reach a commit rather than after CI
# finds them.

set -uo pipefail

fail=0

# --- identity -----------------------------------------------------------------
#
# Refused outright, before anything else is looked at. The wrong address here
# does not break the build; it hands the commit to a different GitHub
# account. tools/check-commit-identity.sh is the one place the permitted
# identity is written down and says why.
#
# Located relative to this file, not to the working tree: core.hooksPath is
# tools/git-hooks, so the checker is one directory up from here wherever the
# hooks directory has been copied to. A checker that is missing is a refusal,
# not a pass; a hook that cannot check has established nothing.
checker="$(dirname "${BASH_SOURCE[0]}")/../check-commit-identity.sh"
if [[ ! -f "$checker" ]]; then
    echo "pre-commit: ERROR no identity checker at ${checker}; refusing to commit unchecked" >&2
    exit 1
fi
if ! bash "$checker" --pending; then
    exit 1
fi

# --- executable bits --------------------------------------------------------
#
# NTFS cannot express the POSIX executable bit, so a script committed from
# Windows records as 100644 and a Linux clone fails with "Permission denied"
# before bash is even reached. Fix it in the index rather than refusing the
# commit: the intent is never "commit a non-executable script".
#
# The hook files in tools/git-hooks/ are swept too, and they have to be matched
# by name because they carry no .sh suffix. This hook was itself recorded 100644
# from the day it was added. Git silently IGNORES a non-executable hook and
# mentions it only as an advice line at commit time, so in any checkout where
# nobody had run install-git-hooks.sh locally -- a fresh clone, or a new
# worktree -- the CRLF and syntax guards below were not running at all. The tool
# whose job is to fix missing executable bits could not fix its own, because it
# was not looking at itself.
#
# A test suite in Python (tools/test-*.py) is run the way the shell ones are,
# by name, by tools/run-tests.sh and by CI, so it is swept by name as well:
# the first one committed from Windows reached CI as 100644.
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    mode="$(git ls-files -s -- "$f" | awk '{print $1}')"
    if [[ "$mode" == "100644" ]]; then
        echo "pre-commit: setting exec bit on ${f}"
        git update-index --chmod=+x -- "$f"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM \
         | grep -E '^(build/stages/|tools/|compartments/tests/).*\.sh$|^tools/test-[A-Za-z0-9_-]+\.py$|^tools/git-hooks/[A-Za-z][A-Za-z0-9_-]*$' \
         || true)

# build/lib/common.sh is sourced, not executed, and stays 644 deliberately.

# --- CRLF -------------------------------------------------------------------
#
# .gitattributes normalises this, but a file added with -f or an editor writing
# CRLF into the index would still produce "bad interpreter: bash^M".
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if git show ":${f}" 2>/dev/null | grep -qU $'\r'; then
        echo "pre-commit: ERROR ${f} contains CRLF; scripts must be LF" >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM \
         | grep -E '\.(sh|rs)$|Makefile' || true)

# --- shell syntax -----------------------------------------------------------
#
# Cheap, and a syntax error in a build stage is worth catching before it is
# committed rather than at minute 35 of a toolchain build.
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ -f "$f" ]] || continue
    if ! bash -n "$f" 2>/dev/null; then
        echo "pre-commit: ERROR ${f} has a shell syntax error" >&2
        bash -n "$f" 2>&1 | sed 's/^/    /' >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)

if [[ "$fail" -ne 0 ]]; then
    echo >&2
    echo "pre-commit: refusing the commit. Fix the above, or use --no-verify" >&2
    echo "if you genuinely intend it." >&2
    exit 1
fi

exit 0
