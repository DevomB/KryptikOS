#!/bin/sh
# kryptik-update: apply a signed release to the inactive root slot and arm one
# trial boot of it, or roll back (docs/design/boot-and-updates.md). Runs as
# root in zone 0, which has no network: the payload arrives as a directory.
#
#   kryptik-update apply DIR [--retry] [--recovery]
#   kryptik-update rollback
#   kryptik-update status
#   kryptik-update check-manifest DIR       verify only: signature, role, version
#   kryptik-update check-pointer FILE SIG   verify only: the pointer's signature
#
#   --retry     arm again a slot whose last trial failed to boot
#   --recovery  accept an older signed release (a downgrade)
#
# DIR holds manifest, manifest.sig, kryptik-root.img, kryptik-a.efi,
# kryptik-b.efi and root.json, and nothing else.
set -eu

PROG=kryptik-update
say() { printf '%s: %s\n' "$PROG" "$*"; }
die() { printf '%s: FAILED: %s\n' "$PROG" "$*" >&2; exit 1; }

NAMESPACE=kryptik-release
MAGIC=KRYPTIK-MANIFEST-1
LATEST_NAMESPACE=kryptik-latest
LATEST_MAGIC=KRYPTIK-LATEST-1
# On the verified root: never under /etc, which the state partition can shadow.
SIGNERS=/usr/share/kryptik/trust/release-signers
ROLE_FILE=/usr/share/kryptik/trust/required-role
DEGRADED=/run/kryptik/state-degraded
B=/var/lib/kryptik/boot
ESP_MNT=/run/kryptik/update-esp
LOCK=/run/kryptik/update.lock
LOG=/var/log/kryptik/update.log
# Where the manifest is copied. Never taken from the environment, since the
# exit trap removes it; a variable only so the offline suite can set it.
SNAP=""

# The update channel's two checks need no root and no devices, and write
# nothing outside their own directory.
case "${1:-}" in
    check-manifest|check-pointer)
        tools="ssh-keygen sha256sum cp awk sed sort head mktemp" ;;
    *)
        tools="ssh-keygen sha256sum blkid dd cp mv sync flock mount umount cmp kryptik-efiboot awk sed sort head wc stat grep blockdev"
        [ "$(id -u)" = 0 ] || die "must run as root"
        mkdir -p "$B" /run/kryptik /var/log/kryptik ;;
esac
for tool in $tools; do
    command -v "$tool" >/dev/null 2>&1 || die "missing tool: $tool"
done
# Only partitions on the root's own disk; an ambiguous label is refused, never
# resolved by taking the first (devices.sh).
case "${1:-}" in
    check-manifest|check-pointer) ;;
    *)
        # shellcheck source=/dev/null
        . /usr/libexec/kryptik/devices.sh ;;
esac

running_slot() { sed -n 's/^slot=//p' /run/kryptik/boot-identity 2>/dev/null; }
other_slot() { case "$1" in a) echo b ;; b) echo a ;; *) echo "" ;; esac; }
running_version() { sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"' | head -1; }
own_part() {   # own_part LABEL -> the partition, or die with what was found
    p="$(kryptik_part "$1" 2>/dev/null)"
    if [ -z "$p" ]; then
        die "no unambiguous partition labelled $1 on this installation's disk $(kryptik_root_disk 2>/dev/null || echo '?') ($(kryptik_part_count "$1" 2>/dev/null || echo 0) there; elsewhere, ignored: $(kryptik_others "$1" 2>/dev/null | tr '\n' ' '))"
    fi
    printf '%s\n' "$p"
}
esp_dev() { own_part kryptik-esp; }
slot_dev() { own_part "kryptik-$1"; }
hdr() { awk -F': ' -v k="$2" '$1==k {print $2; exit}' "$1"; }

mount_esp() {
    dev="$(esp_dev)" || exit 1
    mkdir -p "$ESP_MNT"
    if ! mountpoint -q "$ESP_MNT"; then
        mount -o rw,nosuid,nodev,noexec "$dev" "$ESP_MNT" || die "cannot mount the ESP"
        ESP_MINE=1
    fi
}
# Only a mount this process made: every subcommand exits through the trap,
# the checks the broker runs during an apply among them.
umount_esp() {
    [ "$ESP_MINE" = 1 ] || return 0
    if mountpoint -q "$ESP_MNT" 2>/dev/null; then sync; umount "$ESP_MNT"; fi
    ESP_MINE=0
}
ESP_MINE=0
trap 'umount_esp; [ -n "${SNAP:-}" ] && rm -rf -- "$SNAP"' EXIT

cmd_status() {
    slot="$(running_slot)"; echo "running slot:     ${slot:-unknown} (version $(running_version))"
    echo "trial pending:    $(sed -n 1p "$B/trial" 2>/dev/null || true)$([ -r "$B/trial" ] && printf ' (%s)' "$(sed -n 's/^armed=//p' "$B/trial" | sed 's/1/BootNext armed/;s/0/not yet armed/')" || echo none)"
    echo "last boot result: $(cat "$B/last-result" 2>/dev/null || echo none)"
    echo "failed trial:     $(cat "$B/trial.failed" 2>/dev/null || echo none)"
    # The ESP is an apply's or a rollback's while one holds the lock.
    exec 9>"$LOCK"
    if flock -s -n 9; then
        mount_esp
        echo "committed slot:   $(cat "$ESP_MNT/kryptik/committed-slot" 2>/dev/null || echo unknown)"
        for s in a b; do
            printf 'slot %s:           version %s, kernel %s\n' "$s" "$(cat "$ESP_MNT/kryptik/version-$s" 2>/dev/null || echo none)" \
                "$([ -f "$ESP_MNT/EFI/kryptik/kryptik-$s.efi" ] && echo present || echo absent)"
        done
        umount_esp
    else
        echo "committed slot:   (an update is being applied; ask again when it has ended)"
    fi
    kryptik-efiboot list 2>/dev/null | sed 's/^/  efi: /' || echo "  efi: (efivarfs unavailable)"
}

# The release's four files are opened once and read only through those
# descriptors, so what is hashed is what is written even if the directory
# changes. Links are refused, as is a name replaced while being opened.
pin() {   # pin FD NAME
    f="$dir/$2"
    { [ -f "$f" ] && [ ! -L "$f" ]; } || die "payload lacks $2, or it is not a regular file"
    eval "exec $1< \"\$f\"" || die "cannot open $2"
    [ "$(stat -c %d:%i "$f")" = "$(stat -L -c %d:%i "/proc/self/fd/$1")" ] || die "$2 changed while it was being opened"
}
payload_path() {   # NAME -> where to read it
    case "$1" in
        kryptik-root.img) echo /proc/self/fd/3 ;; kryptik-a.efi) echo /proc/self/fd/4 ;;
        kryptik-b.efi)    echo /proc/self/fd/5 ;; root.json)     echo /proc/self/fd/6 ;;
        *) echo "$dir/$1" ;;
    esac
}

# --- verification, all of it before any write ------------------------------
verify_payload() {   # verify_payload DIR RECOVERY -> sets VERSION ROOT_HASH
    verify_manifest "$1" "$2"
    pin 3 kryptik-root.img; pin 4 kryptik-a.efi; pin 5 kryptik-b.efi; pin 6 root.json

    # Nothing unlisted (a directory listing) before hashing every listed file
    # (gigabytes). Names are compared whole, as text, dotfiles included.
    names="$(sed -n '/^--$/,$p' "$m" | sed '1d' | awk '{print $3}')"
    for f in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        n="$(basename "$f")"
        case "$n" in manifest|manifest.sig) continue ;; esac
        # A payload at the root of an ext4 medium has a lost+found; it must be empty.
        if [ "$n" = "lost+found" ] && [ -d "$f" ] && [ ! -L "$f" ]; then
            [ -z "$(ls -A "$f")" ] || die "unlisted file in the payload: lost+found is not empty"
            continue
        fi
        printf '%s\n' "$names" | grep -Fxq -- "$n" || die "unlisted file in the payload: $n"
    done

    listed=0
    while read -r want_hash want_size rel; do
        [ -n "$rel" ] || continue
        case "$rel" in */*|..*) die "manifest lists a path with a directory component: $rel" ;; esac
        f="$(payload_path "$rel")"
        [ -f "$f" ] || die "listed file missing: $rel"
        got_size="$(stat -L -c %s "$f")"
        [ "$got_size" = "$want_size" ] || die "$rel: size $got_size, manifest says $want_size (truncated or altered)"
        got_hash="$(sha256sum "$f" | cut -c1-64)"
        [ "$got_hash" = "$want_hash" ] || die "$rel: sha256 does not match the manifest"
        listed=$((listed + 1))
    done <<EOF
$(sed -n '/^--$/,$p' "$m" | sed '1d')
EOF
    [ "$listed" = "$count" ] || die "manifest says $count files, $listed listed"
    say "$listed file(s) match the manifest, nothing unlisted"

    # Checks after the first write compare against these signed hashes, never
    # against the payload files again: the payload directory is mutable.
    manifest_hash() { sed -n '/^--$/,$p' "$m" | sed '1d' | awk -v r="$1" '$3==r {print $1; exit}'; }
    H_ROOT="$(manifest_hash kryptik-root.img)"; H_KA="$(manifest_hash kryptik-a.efi)"; H_KB="$(manifest_hash kryptik-b.efi)"
    [ "${#H_ROOT}" = 64 ] && [ "${#H_KA}" = 64 ] && [ "${#H_KB}" = 64 ] || die "the manifest does not list the root image and both kernels"

    # root.json must match the signed image, and both kernels carry its root hash.
    ROOT_HASH="$(sed -n 's/^  "root_hash": "\([0-9a-f]*\)".*/\1/p' /proc/self/fd/6 | head -1)"
    [ "${#ROOT_HASH}" = 64 ] || die "root.json has no root hash"
    ROOT_BYTES="$(sed -n 's/^  "total_bytes": \([0-9]*\).*/\1/p' /proc/self/fd/6 | head -1)"
    ROOT_SHA="$(sed -n 's/^  "sha256": "\([0-9a-f]*\)".*/\1/p' /proc/self/fd/6 | head -1)"
    [ "$(stat -L -c %s /proc/self/fd/3)" = "$ROOT_BYTES" ] || die "root.json total_bytes does not match kryptik-root.img"
    [ "$ROOT_SHA" = "$H_ROOT" ] || die "root.json's sha256 disagrees with the signed manifest's for kryptik-root.img"
    for s in a b; do
        [ "$(grep -a -c -F "$ROOT_HASH" "$(payload_path "kryptik-$s.efi")")" -ge 1 ] \
            || die "kryptik-$s.efi does not embed the root hash $ROOT_HASH; kernel and root are not one release"
    done
    say "both kernels embed root hash $ROOT_HASH"
}

# The manifest's signature and signed headers, one function for apply and
# check-manifest so the two cannot disagree.
verify_manifest() {   # verify_manifest DIR RECOVERY -> sets dir m sig VERSION count
    dir="$1"; recovery="$2"
    [ -f "$dir/manifest" ] || die "no manifest in $dir"
    [ -f "$dir/manifest.sig" ] || die "no manifest.sig in $dir: an unsigned manifest verifies nothing"
    # Copy the manifest and signature once into a private directory and read
    # only the copy: the payload directory is mutable, and re-reading it after
    # the signature check could pick up a swapped-in unsigned manifest.
    SNAP="${SNAP:-$(mktemp -d /run/kryptik/update-manifest.XXXXXX 2>/dev/null || mktemp -d)}"
    chmod 0700 "$SNAP"
    cp -- "$dir/manifest" "$SNAP/manifest" || die "cannot copy the manifest"
    cp -- "$dir/manifest.sig" "$SNAP/manifest.sig" || die "cannot copy the manifest signature"
    m="$SNAP/manifest"; sig="$SNAP/manifest.sig"
    [ "$(head -1 "$m")" = "$MAGIC" ] || die "manifest is not a $MAGIC"

    verify_signed "$m" "$sig" "$NAMESPACE" manifest

    # Headers, from the signed bytes.
    role="$(hdr "$m" role)"; VERSION="$(hdr "$m" version)"; count="$(hdr "$m" files)"
    case "$role" in development|production) ;; *) die "manifest role '$role' is unknown" ;; esac
    [ "$role" = "$(cat "$ROLE_FILE" 2>/dev/null || echo development)" ] \
        || die "manifest role is '$role'; this image requires '$(cat "$ROLE_FILE")'"
    [ -n "$VERSION" ] || die "manifest has no version"
    cur="$(running_version)"
    if [ "$VERSION" = "$cur" ]; then
        die "payload version $VERSION is the running version; nothing to apply"
    fi
    oldest="$(printf '%s\n%s\n' "$VERSION" "$cur" | sort -V | head -1)"
    if [ "$oldest" = "$VERSION" ]; then
        if [ "$recovery" = 1 ]; then
            say "version $VERSION is OLDER than the running $cur: accepted because --recovery was given"
        else
            die "version $VERSION is older than the running $cur. Refusing a downgrade;
an older signed release can reintroduce a fixed defect. --recovery accepts it deliberately."
        fi
    fi
}

# FILE signed by an enrolled key in NAMESPACE: kryptik-release for manifests,
# kryptik-latest for pointers. The trust anchor also limits each key to its
# namespaces, so neither can pass for the other. Each principal is tried.
verify_signed() {   # verify_signed FILE SIG NAMESPACE WHAT
    [ -f "$SIGNERS" ] || die "no trust anchor at $SIGNERS in this image"
    principals="$(ssh-keygen -Y find-principals -s "$2" -f "$SIGNERS" 2>/dev/null || true)"
    [ -n "$principals" ] || die "the $4's signing key is not enrolled in $SIGNERS"
    for principal in $principals; do
        if ssh-keygen -Y verify -f "$SIGNERS" -I "$principal" -n "$3" -s "$2" < "$1" >/dev/null 2>&1; then
            say "signature verifies (signed by $principal)"
            return 0
        fi
    done
    die "the $4 signature does NOT verify (its key is enrolled as: $(echo $principals), and not for $3)"
}

# For the update channel (docs/design/update-channel.md): verify DIR's manifest
# and print what zone 0 will then accept, with the hash of the verified copy.
# Downgrades are refused: nothing from the network is a recovery.
cmd_check_manifest() {
    [ $# = 1 ] && [ -d "$1" ] || die "check-manifest needs the directory holding manifest and manifest.sig"
    # Zone 0 wants the version on stdout's first line; verifying talks on stderr.
    verify_manifest "$1" 0 >&2
    n=0
    while read -r _hash size rel; do
        [ -n "$rel" ] || continue
        case "$rel" in */*|..*) die "manifest lists a path with a directory component: $rel" ;; esac
        case "$size" in ''|*[!0-9]*) die "$rel: '$size' is not a size" ;; esac
        n=$((n + 1))
    done <<EOF
$(sed -n '/^--$/,$p' "$m" | sed '1d')
EOF
    [ "$n" = "$count" ] || die "manifest says $count files, $n listed"
    printf 'version: %s\n' "$VERSION"
    printf 'sha256: %s\n' "$(sha256sum "$m" | cut -c1-64)"
    sed -n '/^--$/,$p' "$m" | sed '1d' | awk 'NF == 3 { print "file", $2, $3 }'
}

# Exit 0 if a copy of FILE is signed by an enrolled key in the pointer
# namespace. What it says, and whether it is a replay, kryptikd judges
# (update.rs).
cmd_check_pointer() {
    [ $# = 2 ] && [ -f "$1" ] && [ -f "$2" ] || die "check-pointer needs the pointer and its signature"
    SNAP="${SNAP:-$(mktemp -d /run/kryptik/update-manifest.XXXXXX 2>/dev/null || mktemp -d)}"
    chmod 0700 "$SNAP"
    cp -- "$1" "$SNAP/latest" || die "cannot copy the pointer"
    cp -- "$2" "$SNAP/latest.sig" || die "cannot copy the pointer's signature"
    [ "$(head -1 "$SNAP/latest")" = "$LATEST_MAGIC" ] || die "the pointer is not a $LATEST_MAGIC"
    verify_signed "$SNAP/latest" "$SNAP/latest.sig" "$LATEST_NAMESPACE" pointer
}

# Verify everything, then write only the inactive slot, read it back, install
# its kernel and arm BootNext. BOOTX64.EFI is left to boot-success, which
# commits once the new slot has come up. Zone data is never written.
cmd_apply() {
    dir=""; retry=0; recovery=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --retry) retry=1 ;;
            --recovery) recovery=1 ;;
            -*) die "unknown option $1" ;;
            *) dir="$1" ;;
        esac
        shift
    done
    [ -n "$dir" ] && [ -d "$dir" ] || die "apply needs a payload directory"
    [ -r "$DEGRADED" ] && die "the state partition is degraded ($(cat "$DEGRADED")); a trial could neither be recorded nor judged"
    exec 9>"$LOCK"
    flock -n 9 || die "another update is in progress (lock $LOCK)"
    slot="$(running_slot)"; target="$(other_slot "$slot")"
    [ -n "$target" ] || die "cannot tell which slot is running (kryptik.slot= missing)"
    if [ -f "$B/trial" ]; then
        die "a trial of slot $(sed -n 1p "$B/trial") is already armed; reboot first, or run rollback"
    fi
    if [ "$retry" != 1 ] && [ -f "$B/trial.failed" ]; then
        die "the last trial of slot $(cat "$B/trial.failed") failed to boot. Pass --retry to arm it again."
    fi

    say "running slot $slot ($(running_version)); target slot $target"
    verify_payload "$dir" "$recovery"

    tdev="$(slot_dev "$target")" || exit 1
    [ -b "$tdev" ] || die "kryptik-$target ($tdev) is not a block device"
    tsize="$(blockdev --getsize64 "$tdev")"
    [ "$tsize" -ge "$ROOT_BYTES" ] || die "slot $target is $tsize bytes; the root image needs $ROOT_BYTES"

    # --- writes begin: the inactive slot only -------------------------------
    say "writing kryptik-$target ($ROOT_BYTES bytes)"
    dd if=/proc/self/fd/3 of="$tdev" bs=4M conv=fsync status=none || die "writing slot $target failed"
    blockdev --flushbufs "$tdev"   # so the read-back is of the device, not of the page cache
    got="$(dd if="$tdev" bs=4M iflag=count_bytes count="$ROOT_BYTES" status=none | sha256sum | cut -c1-64)"
    [ "$got" = "$H_ROOT" ] || die "slot $target read back as $got; the manifest says $H_ROOT"
    say "slot $target verifies after write"

    mount_esp
    mkdir -p "$ESP_MNT/EFI/kryptik" "$ESP_MNT/kryptik"
    cp "$(payload_path "kryptik-$target.efi")" "$ESP_MNT/EFI/kryptik/kryptik-$target.efi.new" || die "staging the kernel on the ESP failed"
    sync -f "$ESP_MNT/EFI/kryptik/kryptik-$target.efi.new"
    # Check the staged kernel before it gets the name rollback and recovery use.
    want_k="$H_KA"; [ "$target" = b ] && want_k="$H_KB"
    if [ "$(sha256sum "$ESP_MNT/EFI/kryptik/kryptik-$target.efi.new" | cut -c1-64)" != "$want_k" ]; then
        rm -f "$ESP_MNT/EFI/kryptik/kryptik-$target.efi.new"
        die "the kernel staged on the ESP does not hash to the manifest's kryptik-$target.efi"
    fi
    mv -f "$ESP_MNT/EFI/kryptik/kryptik-$target.efi.new" "$ESP_MNT/EFI/kryptik/kryptik-$target.efi"
    printf '%s\n' "$VERSION" > "$ESP_MNT/kryptik/version-$target.new"
    mv -f "$ESP_MNT/kryptik/version-$target.new" "$ESP_MNT/kryptik/version-$target"
    sync
    umount_esp
    say "kernel for slot $target installed on the ESP (version $VERSION)"

    # --- arm one trial boot --------------------------------------------------
    arm_trial "$target"
    printf '%s apply %s -> slot %s\n' "$(date -Iseconds 2>/dev/null)" "$VERSION" "$target" >> "$LOG"
    say "armed: the next boot tries slot $target ($VERSION) once. Reboot to try it."
    say "if it does not come up, the firmware falls back to the committed slot ($slot)."
}

# Record armed=0, set BootNext, record armed=1. Interrupted before BootNext,
# the old slot boots and boot-success clears the record; after it, the new
# slot boots and is judged as a trial whatever the armed line says.
arm_trial() {   # arm_trial SLOT
    rm -f "$B/trial.failed"
    printf '%s\narmed=0\n' "$1" > "$B/trial.new" && mv -f "$B/trial.new" "$B/trial" && sync
    if ! kryptik-efiboot set-next "$1"; then
        rm -f "$B/trial"; sync
        die "could not arm BootNext for slot $1; the trial record was removed"
    fi
    printf '%s\narmed=1\n' "$1" > "$B/trial.new" && mv -f "$B/trial.new" "$B/trial" && sync
}

cmd_rollback() {
    [ -r "$DEGRADED" ] && die "the state partition is degraded ($(cat "$DEGRADED")); a trial could neither be recorded nor judged"
    exec 9>"$LOCK"
    flock -n 9 || die "another update is in progress (lock $LOCK)"
    slot="$(running_slot)"; target="$(other_slot "$slot")"
    [ -n "$target" ] || die "cannot tell which slot is running"
    mount_esp
    [ -f "$ESP_MNT/EFI/kryptik/kryptik-$target.efi" ] || die "slot $target has no kernel on the ESP; nothing to roll back to"
    ver="$(cat "$ESP_MNT/kryptik/version-$target" 2>/dev/null || echo unknown)"
    umount_esp
    tdev="$(slot_dev "$target")" || exit 1
    [ -b "$tdev" ] || die "kryptik-$target ($tdev) is not a block device"
    # The slot must hold a filesystem, not zeros: check the ext4 magic.
    magic="$(dd if="$tdev" bs=1 skip=1080 count=2 status=none | od -An -tx1 | tr -d ' \n')"
    [ "$magic" = "53ef" ] || die "slot $target holds no filesystem (magic $magic); it was never installed"
    arm_trial "$target"
    printf '%s rollback -> slot %s (%s)\n' "$(date -Iseconds 2>/dev/null)" "$target" "$ver" >> "$LOG"
    say "armed: the next boot tries slot $target ($ver) once; boot-success commits it if it comes up. Reboot."
}

case "${1:-}" in
    apply)    shift; cmd_apply "$@" ;;
    rollback) cmd_rollback ;;
    status)   cmd_status ;;
    check-manifest) shift; cmd_check_manifest "$@" ;;
    check-pointer)  shift; cmd_check_pointer "$@" ;;
    *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
