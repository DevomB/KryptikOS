#!/bin/sh
# kryptik-chrome: the trusted desktop chrome, text edition.
#
# Runs in zone 0 as the session user, on the compositor directly - no proxy
# in between - which is what makes it trusted: everything it shows comes
# from the compositor and the launch daemon, never from a zone, and dwl
# draws its windows with the UNZONED border (build/desktop/zone-colours.h),
# the one colour no zone client can be given. A zone cannot draw over it
# (no layer shell through the proxy), read its input (no global input
# through the proxy) or capture it (no screencopy through the proxy).
#
#   kryptik-chrome                 dwl's startup command (`dwl -s`): reads
#                                  dwl's status stream on stdin, records the
#                                  focused zone in $XDG_RUNTIME_DIR/kryptik/
#                                  focus as text, and opens the launcher
#   kryptik-chrome --menu          the launcher: zones, their state, apps
#   kryptik-chrome --prompt ZONE [--no-display] -- CMD [ARG...]
#                                  ask for the zone's passphrase in a trusted
#                                  window, then launch (kryptik-launch hands
#                                  over here when it has no terminal)
#   kryptik-chrome --focus         print the focused zone, from the record
#   kryptik-chrome --confirm ID    the transfer question ID, asked in a trusted
#                                  window; the answer goes back to the broker
#
# The launcher and the prompt are terminal windows (havoc) running this
# script: the passphrase is read by kryptik-launch on that terminal, travels
# to the daemon as a descriptor, and never touches argv or the environment.

# The zone files on the verified root, not the /etc symlink to them: /etc is
# an overlay the state partition can shadow, and the text identity this
# chrome shows must come from the same place as the colours dwl draws.
ZONES=/usr/lib/kryptik/zones
LAUNCH=/usr/bin/kryptik-launch
# havoc's form is `havoc [option...] [program [args...]]`: the program follows
# the options directly. It has no -e, and an option it does not know makes it
# print its usage and exit - which is what every window this chrome opened
# did on the first installed system, silently, so the session had no
# launcher window at all ("(no window)" in the focus record).
TERMINAL=/usr/bin/havoc
RT="${XDG_RUNTIME_DIR:-/tmp}"
FOCUS="$RT/kryptik/focus"
CONSENT=/run/kryptik-consent

die() { echo "kryptik-chrome: $*" >&2; exit 1; }

# The zone's label, glyph and description from its definition: text
# identity, as the zone files declare it (compositor/zoneid audits them).
zone_field() { # zone key
    sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\\(.*\\)\"[[:space:]]*$/\\1/p" "$ZONES/$1.toml" 2>/dev/null | head -1
}
zone_is_nic() { grep -q '^mode[[:space:]]*=[[:space:]]*"nic"' "$ZONES/$1.toml" 2>/dev/null; }

# --- the status stream ---------------------------------------------------------

# dwl writes, per output, `<output> title <t>`, `<output> appid <id>`,
# `<output> fullscreen <0|1>` ... whenever focus or state changes. The
# app_id of a zone window is kryptik.<zone>.<claimed>, stamped by the
# proxy; anything else is zone 0's own (this chrome, say).
run_status() {
    mkdir -p "$RT/kryptik" 2>/dev/null
    appid=""; title=""; fs=0
    # The launcher window, so a fresh session shows something usable.
    "$TERMINAL" /usr/bin/kryptik-chrome --menu &
    # The consent watcher: every question the broker leaves gets one
    # trusted window, and the answer is that window's alone. A question
    # nobody answers is withdrawn by the broker after its deadline.
    #
    # The lock is how the broker knows someone is here to ask: held
    # exclusively for as long as this watcher runs (kryptikd consent.rs
    # takes it shared to test for us, and refuses a transfer at once when
    # it can). Released by the kernel when this subshell dies, however it
    # dies, so a session that ended leaves no promise behind. The confirm
    # windows do not inherit it: a lingering question must not look like a
    # watcher. One watcher per channel: a second session's exits quietly.
    (
        exec 9> "$CONSENT/watcher.lock" 2>/dev/null || exit 0
        flock -n 9 || exit 0
        while :; do
            for ask in "$CONSENT"/*.ask; do
                [ -e "$ask" ] || continue
                id="${ask##*/}"; id="${id%.ask}"
                [ -e "$CONSENT/$id.dialog" ] && continue
                : > "$CONSENT/$id.dialog" 2>/dev/null || continue
                "$TERMINAL" /usr/bin/kryptik-chrome --confirm "$id" 9>&- &
            done
            for d in "$CONSENT"/*.dialog; do
                [ -e "$d" ] || continue
                [ -e "${d%.dialog}.ask" ] || rm -f "$d"
            done
            sleep 1
        done
    ) &
    while IFS= read -r line; do
        out="${line%% *}"; rest="${line#* }"; key="${rest%% *}"; val="${rest#* }"
        [ "$key" = "$rest" ] && val=""
        case "$key" in
            appid) appid="$val" ;;
            title) title="$val" ;;
            fullscreen) fs="$val" ;;
            *) continue ;;
        esac
        case "$appid" in
            kryptik.*) zone="${appid#kryptik.}"; zone="${zone%%.*}" ;;
            "") zone="-" ;;
            *) zone="0" ;;
        esac
        label="$(zone_field "$zone" label)"
        glyph="$(zone_field "$zone" glyph)"
        [ "$zone" = "0" ] && label="ZONE 0 (trusted)"
        [ "$zone" = "-" ] && label="(no window)"
        [ -n "$label" ] || label="UNKNOWN ZONE $zone"
        tmp="$FOCUS.tmp.$$"
        printf 'output=%s\nzone=%s\nlabel=%s\nglyph=%s\ntitle=%s\nfullscreen=%s\n' \
            "$out" "$zone" "$label" "$glyph" "$title" "$fs" > "$tmp" && mv -f "$tmp" "$FOCUS"
        echo "focus: zone=$zone label=$label fullscreen=$fs title=$title" >&2
    done
}

# --- the launcher ---------------------------------------------------------------

menu_zones() {
    n=0
    for f in "$ZONES"/*.toml; do
        [ -f "$f" ] || continue
        z="$(basename "$f" .toml)"
        zone_is_nic "$z" && continue
        n=$((n + 1))
        eval "Z$n=\"\$z\""
        info="$("$LAUNCH" --info "$z" 2>/dev/null)"
        enc="$(printf '%s\n' "$info" | sed -n 's/^encrypted //p')"
        run="$(printf '%s\n' "$info" | sed -n 's/^running //p')"
        state=""
        [ "$enc" = yes ] && state="encrypted "
        [ "$run" = yes ] && state="${state}RUNNING" || state="${state}stopped"
        [ -z "$info" ] && state="(daemon not answering)"
        printf '  %d) %-10s %-3s %-10s %s\n' "$n" "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)" "$state"
    done
    NZONES=$n
}

run_menu() {
    while :; do
        clear 2>/dev/null
        echo "================ KRYPTIK - trusted launcher (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo "Zone windows carry their zone's colour and a [zone] title prefix."
        echo
        echo "Zones:"
        menu_zones
        echo
        echo "Apps:  t terminal   e editor (nano)   b browser (lynx, needs routed network)"
        echo "Also:  s<N> stop zone N   m<N><M> move zone N's clipboard to zone M (one payload, once)"
        echo "       f focused zone   r refresh   q close this window"
        echo
        printf 'choice (e.g. 1t): '
        if ! read -r choice; then break; fi
        case "$choice" in
            q) break ;;
            r|"") continue ;;
            f) cat "$FOCUS" 2>/dev/null || echo "no focus record yet"; sleep 2; continue ;;
            m[1-9][1-9]) a="${choice#m}"; b="${a#?}"; a="${a%?}"
                      eval "za=\"\${Z$a:-}\""; eval "zb=\"\${Z$b:-}\""
                      [ -n "$za" ] && [ -n "$zb" ] || { echo "no such zones"; sleep 1; continue; }
                      echo "moving the clipboard of $za to $zb (this is the only way a payload crosses zones)"
                      "$LAUNCH" --clipboard-move "$za" "$zb" || sleep 2
                      sleep 1; continue ;;
            s[1-9]*) idx="${choice#s}"; eval "z=\"\${Z$idx:-}\""
                      [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                      "$LAUNCH" --stop "$z"; sleep 1; continue ;;
            [1-9]*[teb]) idx="${choice%?}"; app="${choice#"$idx"}"; eval "z=\"\${Z$idx:-}\""
                      [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                      case "$app" in
                          t) set -- "$TERMINAL" ;;
                          e) set -- "$TERMINAL" /usr/bin/nano ;;
                          b) set -- "$TERMINAL" /usr/bin/lynx ;;
                      esac
                      echo "launching in zone $z: $*"
                      # --ask: the passphrase, if the zone needs one, is read on
                      # THIS terminal - zone 0's window - and never on a zone's.
                      "$LAUNCH" --ask "$z" -- "$@" || sleep 3
                      ;;
            *) echo "?"; sleep 1 ;;
        esac
    done
}

# --- the prompt -----------------------------------------------------------------

run_prompt() { # ZONE [--no-display] -- CMD...
    zone="$1"; shift
    nodisp=""
    [ "${1:-}" = "--no-display" ] && { nodisp="--no-display"; shift; }
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || die "--prompt: no command"
    [ -n "${WAYLAND_DISPLAY:-}" ] || die "--prompt: no display to draw the prompt on"
    # A trusted window whose only content is the question. kryptik-launch
    # reads the answer from this terminal and sends it as a descriptor.
    exec "$TERMINAL" /usr/bin/kryptik-launch --ask $nodisp "$zone" -- "$@"
}

run_confirm() { # ID
    id="$1"
    ask="$CONSENT/$id.ask"
    [ -r "$ask" ] || { echo "kryptik-chrome: no question $id (withdrawn?)"; sleep 2; exit 1; }
    # A question with no kind is a transfer, as every question once was.
    kind="$(sed -n 's/^kind=//p' "$ask")"
    if [ "$kind" = clock ]; then
        # The clock (docs/design/time.md): the network's answer is further
        # from this machine's clock than zone 0 believes without asking.
        # Both times are shown, because a person with a watch can answer
        # and nothing on this system can.
        now="$(sed -n 's/^now=//p' "$ask")"; proposed="$(sed -n 's/^proposed=//p' "$ask")"
        sources="$(sed -n 's/^sources=//p' "$ask")"
        echo "================ KRYPTIK - set the clock? (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo
        printf 'The network says it is   %s\n' "$proposed"
        printf 'This machine says it is  %s\n' "$now"
        printf '    (the median of %s time server(s), asked by the net zone, which is not trusted)\n' "$sources"
        echo
        echo "Check a watch or a phone. A wrong clock makes expired certificates"
        echo "look valid and old updates look new. Cancelling leaves the clock alone."
        echo
        printf 'Set the clock to the network'"'"'s time? [y/N] '
    else
        from="$(sed -n 's/^from=//p' "$ask")"; to="$(sed -n 's/^to=//p' "$ask")"
        name="$(sed -n 's/^name=//p' "$ask")"; bytes="$(sed -n 's/^bytes=//p' "$ask")"
        echo "================ KRYPTIK - transfer request (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo
        printf 'Zone %s (%s) wants to send a file to zone %s (%s):\n' "$from" "$(zone_field "$from" label)" "$to" "$(zone_field "$to" label)"
        printf '    %s   (%s bytes)\n' "$name" "$bytes"
        echo
        echo "It will land in the receiving zone's incoming/ directory. Nothing else"
        echo "is shared. Cancelling leaves both zones as they are."
        echo
        printf 'Allow this transfer? [y/N] '
    fi
    answer=no
    if read -r reply; then
        case "$reply" in y|Y|yes|YES) answer=yes ;; esac
    fi
    printf '%s\n' "$answer" > "$CONSENT/$id.answer.tmp" && mv -f "$CONSENT/$id.answer.tmp" "$CONSENT/$id.answer"
    echo "-> $answer"
    sleep 1
}

case "${1:-}" in
    "") run_status ;;
    --confirm) [ -n "${2:-}" ] || die "--confirm needs an id"; run_confirm "$2" ;;
    --menu) run_menu ;;
    --prompt) shift; run_prompt "$@" ;;
    --focus) cat "$FOCUS" 2>/dev/null || { echo "zone=-"; exit 1; } ;;
    *) die "usage: kryptik-chrome [--menu | --prompt ZONE [--no-display] -- CMD... | --focus]" ;;
esac
