#!/bin/sh
# kryptik-chrome: the trusted desktop chrome, text edition.
#
# Runs in zone 0 on the compositor directly, with no proxy in between: what it
# shows comes from the compositor and the launch daemon, never from a zone, and
# dwl gives its windows the UNZONED border (build/desktop/zone-colours.h). No
# zone can draw over it by itself, read its input or capture it: the proxy
# passes no layer shell, global input or screencopy, dwl never draws a
# zone's cursor image, and a zone's window covers the chrome only
# fullscreen, by the user's Alt+e, until the chrome opens another window.
#
#   kryptik-chrome                 dwl's startup command (`dwl -s`): reads
#                                  dwl's status stream on stdin, records the
#                                  focused zone in $XDG_RUNTIME_DIR/kryptik/
#                                  focus as text (and the last zone window's
#                                  in focus.zone), opens the launcher and
#                                  starts the idle lock
#   kryptik-chrome --menu          the launcher: zones, their state, apps,
#                                  the network as the net zone reports it, a
#                                  release that waits to be installed, a
#                                  channel with nothing new for 30 days, the
#                                  net zone's Wi-Fi networks (w), the battery,
#                                  and sound: the volume, and which zone may
#                                  record
#   kryptik-chrome --prompt ZONE [--no-display] -- CMD [ARG...]
#                                  ask for the zone's passphrase in a trusted
#                                  window, then launch (kryptik-launch hands
#                                  over here when it has no terminal)
#   kryptik-chrome --focus         print the focused zone, from the record
#   kryptik-chrome --confirm ID    ask the broker's question ID in a trusted window: yes only
#                                  for the code it shows, typed after it shows
#   kryptik-chrome --microphone ZONE
#                                  say, for as long as ZONE holds the microphone,
#                                  that it does and whether it is recording
#   kryptik-chrome --camera ZONE   say, for as long as ZONE holds the camera, that
#                                  it does
#   kryptik-chrome --battery       warn that the battery is low, until on mains
#   kryptik-chrome --waiting       after a sleep, ask in turn for the passphrase of
#                                  each zone whose volume lost its key with it
#   kryptik-chrome --sticks        the USB sticks plugged in: which zone gets which,
#                                  to read or to write too, and taking one back;
#                                  a stick plugged in opens it
#
# Passphrases are read by kryptik-launch on the chrome's own terminal and go
# to the daemon as a descriptor, never in argv or the environment.

# The verified root's zone files, which dwl's colours match: the state partition can shadow /etc.
ZONES=/usr/lib/kryptik/zones
LAUNCH=/usr/bin/kryptik-launch
SOUND=/usr/libexec/kryptik/kryptik-sound
# havoc takes the program as plain arguments: it has no -e, and exits on an unknown option.
TERMINAL=/usr/bin/havoc
RT="${XDG_RUNTIME_DIR:-/tmp}"
FOCUS="$RT/kryptik/focus"
# The last zone window, for the menu: once the menu has focus, the focus record names zone 0.
FOCUS_ZONE="$RT/kryptik/focus.zone"
CONSENT=/run/kryptik-consent
# The power service's last look (power.sh): the source, the charge and its warning.
POWER=/run/kryptik-power/state
SYS_BLOCK=/sys/class/block
# kryptikd's record of the camera's grant (camera.rs), and its note that the driver stayed loaded.
CAMERA=/run/kryptik-camera/grant
CAMERA_STAYED=/run/kryptik-camera/stayed

die() { echo "kryptik-chrome: $*" >&2; exit 1; }

# A quoted field of the zone file, such as its label or glyph.
zone_field() { # zone key
    sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\\(.*\\)\"[[:space:]]*$/\\1/p" "$ZONES/$1.toml" 2>/dev/null | head -1
}
zone_is_nic() { grep -q '^mode[[:space:]]*=[[:space:]]*"nic"' "$ZONES/$1.toml" 2>/dev/null; }

# --- the status stream ---------------------------------------------------------

# dwl writes `<output> title <t>`, `<output> appid <id>`, `<output> fullscreen
# <0|1>` ... on every focus or state change, one output after another, each
# output's lines ending with layout. The proxy stamps a zone window's app_id
# kryptik.<zone>.<claimed>; any other app_id is zone 0's.
#
# The record is the selected output's window. Only that output's layout line
# publishes: with two monitors, the one dwl writes last need not be the one
# in use.
status_to_focus() {
    appid=""; title=""; fs=""; selected=0
    while IFS= read -r line; do
        out="${line%% *}"; rest="${line#* }"; key="${rest%% *}"; val="${rest#* }"
        [ "$key" = "$rest" ] && val=""
        case "$key" in
            title) title="$val"; appid=""; fs=""; selected=0; continue ;;
            appid) appid="$val"; continue ;;
            fullscreen) fs="$val"; continue ;;
            selmon) selected="$val"; continue ;;
            layout) [ "$selected" = 1 ] || continue ;;
            *) continue ;;
        esac
        case "$appid" in
            kryptik.*) zone="${appid#kryptik.}"; zone="${zone%%.*}" ;;
            "") zone="-" ;;
            *) zone="0" ;;
        esac
        label="$(zone_field "$zone" label)"
        glyph="$(zone_field "$zone" glyph)"
        [ "$zone" = "0" ] && label="ZONE 0 (trusted)"
        [ "$zone" = "-" ] && label="(no window)"
        [ -n "$label" ] || label="UNKNOWN ZONE $zone"
        tmp="$FOCUS.tmp.$$"
        printf 'output=%s\nzone=%s\nlabel=%s\nglyph=%s\ntitle=%s\nfullscreen=%s\n' \
            "$out" "$zone" "$label" "$glyph" "$title" "$fs" > "$tmp" && mv -f "$tmp" "$FOCUS"
        # The zone comes from the app_id the proxy stamps; a title is the zone's own words.
        case "$zone" in
            0|-) ;;
            *) cp -f "$FOCUS" "$FOCUS_ZONE.tmp.$$" && mv -f "$FOCUS_ZONE.tmp.$$" "$FOCUS_ZONE" ;;
        esac
        echo "focus: zone=$zone label=$label fullscreen=$fs title=$title" >&2
    done
}

# Whether the device-mapper device NAME is suspended, from sysfs alone.
dm_suspended() {
    for d in /sys/block/dm-*; do
        [ "$(cat "$d/dm/name" 2>/dev/null)" = "$1" ] || continue
        [ "$(cat "$d/dm/suspended" 2>/dev/null)" = 1 ]
        return
    done
    return 1
}
# The zones whose volume lost its key with a sleep and waits, frozen, for its passphrase.
waiting_zones() {
    for d in /sys/block/dm-*; do
        [ "$(cat "$d/dm/suspended" 2>/dev/null)" = 1 ] || continue
        n="$(cat "$d/dm/name" 2>/dev/null)"
        case "$n" in kryptik-zone-*) printf '%s\n' "${n#kryptik-zone-}" ;; esac
    done
}

run_status() {
    mkdir -p "$RT/kryptik" 2>/dev/null
    # The menu window, so a fresh session shows something usable.
    "$TERMINAL" /usr/bin/kryptik-chrome --menu &
    # The screen locks after ten minutes without input, or the minutes the user's
    # lock-idle file holds; 0 never. expr reads 08 as eight, where $((...)) fails.
    idle="$(tr -cd 0-9 2>/dev/null < "${XDG_CONFIG_HOME:-$HOME/.config}/kryptik/lock-idle" | cut -c1-4)"
    idle="$(expr "${idle:-10}" \* 60)"
    # The machine sleeps that many minutes after the lock only when the user's lock-sleep file
    # says so: a sleep that does not wake would cost open work nobody chose to risk, and
    # resume is not yet proven on physical hardware.
    nap="$(tr -cd 0-9 2>/dev/null < "${XDG_CONFIG_HOME:-$HOME/.config}/kryptik/lock-sleep" | cut -c1-4)"
    nap="$(expr "${nap:-0}" \* 60)"
    if [ "$idle" -gt 0 ] && [ "$nap" -gt 0 ]; then
        /usr/bin/kryptik-lock --idle "$idle" --sleep "$nap" &
    elif [ "$idle" -gt 0 ]; then
        /usr/bin/kryptik-lock --idle "$idle" &
    fi
    # The consent watcher. Holding watcher.lock tells the broker someone is here
    # to ask: consent.rs refuses at once if it can take the lock shared. The
    # kernel drops it with this subshell, and a second session's watcher exits
    # quietly.
    (
        exec 9> "$CONSENT/watcher.lock" 2>/dev/null || exit 0
        flock -n 9 || exit 0
        # Writes create, never follow or clobber: group kryptik can plant links here.
        # That also makes each .dialog claim one exclusive create.
        set -C
        while :; do
            for ask in "$CONSENT"/*.ask; do
                [ -e "$ask" ] || continue
                id="${ask##*/}"; id="${id%.ask}"
                [ -e "$CONSENT/$id.dialog" ] && continue
                : > "$CONSENT/$id.dialog" 2>/dev/null || continue
                # A window must not hold the lock past the watcher's death.
                "$TERMINAL" /usr/bin/kryptik-chrome --confirm "$id" 9>&- &
            done
            # A window may write its code and answer after its question is withdrawn.
            for f in "$CONSENT"/*.dialog "$CONSENT"/*.code "$CONSENT"/*.answer; do
                [ -e "$f" ] || continue
                [ -e "${f%.*}.ask" ] || rm -f "$f"
            done
            sleep 1
        done
    ) &
    # While a zone holds the microphone, a window of the chrome's says so, and when it records;
    # as the battery reaches 10% and again 5%, a window warns of the power-off at 3%; and once
    # the state partition is back after a sleep, a window asks for each waiting zone's passphrase.
    (
        shown="" filming="" warned="" waited="" blocks="" seen=""
        while :; do
            mic="$("$SOUND" --control status 2>/dev/null | sed -n 's/^zone \([^ ]*\) .* granted.*/\1/p' | head -1)"
            if [ -n "$mic" ] && [ "$mic" != "$shown" ]; then
                "$TERMINAL" /usr/bin/kryptik-chrome --microphone "$mic" &
            fi
            shown="$mic"
            cam="$(camera_zone)"
            if [ -n "$cam" ] && [ "$cam" != "$filming" ]; then
                "$TERMINAL" /usr/bin/kryptik-chrome --camera "$cam" &
            fi
            filming="$cam"
            w="$(power_field warning)"
            if [ -n "$w" ] && [ "$w" != "$warned" ]; then
                "$TERMINAL" /usr/bin/kryptik-chrome --battery &
            fi
            warned="$w"
            if ! dm_suspended kryptik-state; then
                wz="$(waiting_zones | tr '\n' ' ')"
                if [ -n "$wz" ] && [ "$wz" != "$waited" ]; then
                    "$TERMINAL" /usr/bin/kryptik-chrome --waiting &
                fi
                waited="$wz"
            fi
            # A stick plugged in opens the window that asks which zone gets it.
            set -- "$SYS_BLOCK"/*
            if [ "$*" != "$blocks" ]; then
                blocks="$*"
                if sticks_new; then "$TERMINAL" /usr/bin/kryptik-chrome --sticks & fi
            fi
            sleep 1
        done
    ) &
    status_to_focus
}

# The battery's warning: the charge, what comes at 3%, and the charge again as it falls; it
# closes once the machine is on mains, or after ten minutes (Alt+Shift+c closes it sooner).
run_battery() {
    clear 2>/dev/null
    echo "================ KRYPTIK - the battery (zone 0) ================"
    echo "The battery is low. At 3% the zones stop, each closing its volume, and the"
    echo "machine powers off. Plug it in, or save what you are working on now."
    echo
    said="" n=0
    while [ "$(power_field source)" = battery ] && [ "$n" -lt 120 ]; do
        chg="$(power_field charge)"
        [ "$chg" = "$said" ] || { echo "at ${chg}%"; said="$chg"; }
        n=$((n + 1))
        sleep 5
    done
    [ "$(power_field source)" = battery ] || { echo "On mains now."; sleep 2; }
}

# After a sleep, each zone whose volume lost its key with it, its passphrase asked for in turn on
# this zone 0 terminal; Enter alone leaves the zone waiting for the menu's p<N>.
run_waiting() {
    clear 2>/dev/null
    echo "================ KRYPTIK - after the sleep (zone 0) ================"
    echo "These zones lost their volume's key with the sleep and stay frozen until it is"
    echo "given: their windows show, but do not answer. Enter alone leaves a zone waiting;"
    echo "the menu (Alt+p) gives its passphrase later with p and its number, or stops it."
    for z in $(waiting_zones); do
        # Given meanwhile from the menu, it waits no more.
        dm_suspended "kryptik-zone-$z" || continue
        echo
        printf 'Zone %s %s %s\n' "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)"
        "$LAUNCH" --resume "$z" || sleep 2
    done
    sleep 1
}

# The zone that holds the camera, as kryptikd recorded it; nothing when none does.
camera_zone() { sed -n 's/^zone //p' "$CAMERA" 2>/dev/null; }

# The camera's window: open from the grant to its end.
run_camera() {
    z="$1"
    clear 2>/dev/null
    echo "================ KRYPTIK - the camera (zone 0) ================"
    printf 'Zone %s %s %s holds the camera, %s,\n' "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)" \
        "$(sed -n 's/^name //p' "$CAMERA" 2>/dev/null)"
    echo "until it stops or the screen locks. Alt+p, then k and Enter, takes it back."
    while [ "$(camera_zone)" = "$z" ]; do
        sleep 1
    done
    echo "The camera is no longer zone $z's."
    [ -e "$CAMERA_STAYED" ] && echo "Its driver stays loaded, still held by a program, until the next grant."
    sleep 2
}

# The microphone's window: open from the grant to its end, with each change of state on a line.
run_microphone() {
    z="$1" said=""
    clear 2>/dev/null
    echo "================ KRYPTIK - the microphone (zone 0) ================"
    printf 'Zone %s %s %s holds the microphone until it stops.\n' "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)"
    echo "Alt+p, then c and Enter, or the keyboard's microphone key, takes it back."
    echo
    while :; do
        line="$("$SOUND" --control status 2>/dev/null | grep "^zone $z ")"
        case "$line" in
            *" granted recording") now="RECORDING NOW" ;;
            *" granted") now="not recording" ;;
            *) break ;;
        esac
        [ "$now" = "$said" ] || { echo "$now"; said="$now"; }
        sleep 1
    done
    echo "The microphone is no longer zone $z's."
    sleep 2
}

# --- the launcher ---------------------------------------------------------------

menu_zones() {
    n=0
    for f in "$ZONES"/*.toml; do
        [ -f "$f" ] || continue
        z="$(basename "$f" .toml)"
        zone_is_nic "$z" && continue
        n=$((n + 1))
        eval "Z$n=\"\$z\""
        info="$("$LAUNCH" --info "$z" 2>/dev/null)"
        enc="$(printf '%s\n' "$info" | sed -n 's/^encrypted //p')"
        run="$(printf '%s\n' "$info" | sed -n 's/^running //p')"
        waits="$(printf '%s\n' "$info" | sed -n 's/^waiting //p')"
        stick="$(printf '%s\n' "$info" | sed -n 's/^stick //p')"
        state=""
        [ "$enc" = yes ] && state="encrypted "
        [ "$run" = yes ] && state="${state}RUNNING" || state="${state}stopped"
        [ "$waits" = yes ] && state="${state}, WAITING for its passphrase (p$n)"
        case "$stick" in
            "ro "*) state="${state}, holds a USB stick to read (d)" ;;
            "rw "*) state="${state}, holds a USB stick to write (d)" ;;
        esac
        [ -z "$info" ] && state="(daemon not answering)"
        printf '  %d) %-10s %-3s %-10s %s\n' "$n" "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)" "$state"
    done
}

# The net zone's own word on the network, which the daemon passes on only in its own words:
# ready or not, the Wi-Fi network, the uplink's address and DNS.
menu_network() {
    for f in "$ZONES"/*.toml; do
        [ -f "$f" ] || continue
        z="$(basename "$f" .toml)"
        zone_is_nic "$z" || continue
        info="$("$LAUNCH" --info "$z" 2>/dev/null)"
        net="$(printf '%s\n' "$info" | sed -n 's/^network //p')"
        if [ -z "$net" ]; then
            printf '%s\n' "$info" | grep -qx 'running yes' && net="starting" || net="the net zone is not running"
        fi
        echo
        echo "Network: $net"
    done
}

# The battery and whether the machine runs on it, as the power service last saw them, so the
# menu says what the service acts on; nothing without a battery.
power_field() { sed -n "s/^$1=//p" "$POWER" 2>/dev/null; }
menu_power() {
    chg="$(power_field charge)"
    case "$chg" in ""|*[!0-9]*) return 0 ;; esac
    echo
    if [ "$(power_field source)" = battery ]; then
        echo "Power: on battery, at ${chg}%; at 3% the zones stop and the machine powers off"
    else
        echo "Power: on mains, the battery at ${chg}%"
    fi
}

# A release that has arrived whole waits for the user, so the launcher says so.
# So does a channel gone quiet: statements are re-signed on a schedule, and a
# net zone that withholds them leaves only their age to show it.
menu_update() {
    st="$("$LAUNCH" --update status 2>/dev/null)"
    v="$(printf '%s\n' "$st" | sed -n 's/^staged *\([^:]*\): .*, complete.*/\1/p')"
    # kryptikd's words up to their reason: the newest statement's age or, with none ever accepted, the install's.
    quiet="$(printf '%s\n' "$st" | sed -n 's/^ *\(no statement from the release key [^:]*\):.*/\1/p' | head -1)"
    # A trial armed or failed: what is staged is the release it tries or tried, which apply would refuse.
    trial="$(printf '%s\n' "$st" | sed -n 's/^trial *//p' | head -1)"
    [ -n "$v$quiet$trial" ] || return 0
    echo
    [ -z "$quiet" ] || echo "Update: ${quiet} (u for more)"
    case "$trial" in
        "the trial of "*) echo "Update: ${trial%%;*}; this machine runs the release before it (u for more)"; return 0 ;;
        "slot "?" is armed:"*) echo "Update: ${trial%%:*}: the next boot tries it (u for more)"; return 0 ;;
        "slot "?" is on trial:"*) echo "Update: ${trial%%:*}: it stays once it comes up healthy (u for more)"; return 0 ;;
    esac
    [ -z "$v" ] && return 0
    echo "Update: ${v} has arrived. u installs it, and the next boot tries it."
}

# Zone 0's mixer on one line: the volume, and the zone that may record and whether it does.
menu_sound() {
    st="$("$SOUND" --control status 2>/dev/null)" || return 0
    vol="$(printf '%s\n' "$st" | sed -n 's/^master \([0-9]*\).*/\1/p')"
    printf '%s\n' "$st" | grep -q '^master [0-9]* muted' && vol="$vol, muted"
    mic="$(printf '%s\n' "$st" | sed -n 's/^zone \([^ ]*\) .* granted.*/\1/p')"
    printf '%s\n' "$st" | grep -q ' recording$' && mic="$mic, RECORDING NOW"
    echo
    echo "Sound: volume ${vol}; the microphone: ${mic:-no zone}"
}

# The camera on one line: the zone that holds it, or that none does.
menu_camera() {
    z="$(camera_zone)"
    if [ -n "$z" ]; then
        echo "Camera: zone $z holds it ($(sed -n 's/^name //p' "$CAMERA" 2>/dev/null))"
    elif [ -e "$CAMERA_STAYED" ]; then
        echo "Camera: no zone; its driver stays loaded, still held by a program, until the next grant"
    else
        echo "Camera: no zone"
    fi
}

# The update channel's verbs through the launch daemon, as `kryptik update` has
# them at the administration login. Installing asks first: it arms a trial of
# the release at the next boot.
run_update() {
    while :; do
        clear 2>/dev/null
        echo "================ KRYPTIK - updates (zone 0) ================"
        "$LAUNCH" --update status 2>&1 | sed 's/^/  /'
        echo
        echo "f fetch the newest release   x forget it   i install what has arrived"
        echo "a fetch each release as it comes   m only when asked   Enter back"
        printf 'choice: '
        read -r c || return 0
        case "$c" in
            "") return 0 ;;
            f) "$LAUNCH" --update fetch ;;
            x) "$LAUNCH" --update forget ;;
            i) printf 'install it, for a trial at the next boot? (y/N): '
               read -r yes || return 0
               [ "$yes" = y ] || continue
               echo "installing: the other slot is written and read back, which takes a few minutes"
               if "$LAUNCH" --update apply; then
                   echo "To try it, reboot: at the administration login (Ctrl+Alt+F2), su, then reboot."
               fi
               printf '(Enter) '; read -r _ || return 0; continue ;;
            a) "$LAUNCH" --update auto on ;;
            m) "$LAUNCH" --update auto off ;;
            *) echo "?" ;;
        esac
        sleep 3
    done
}

run_menu() {
    while :; do
        clear 2>/dev/null
        echo "================ KRYPTIK - trusted launcher (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo "Zone windows carry their zone's colour; f names the last one you had."
        echo
        echo "Zones:"
        menu_zones
        menu_network
        menu_power
        menu_update
        menu_sound
        menu_camera
        echo
        echo "Apps:  t terminal   e editor (nano)   b browser (lynx, needs routed network)"
        echo "Admin: u updates: what the channel names, fetch, forget, install"
        echo "Also:  s<N> stop zone N   m<N><M> move zone N's clipboard to zone M (one payload, once)"
        echo "       w Wi-Fi networks   f the last zone window's zone   r refresh   q close this window"
        echo "       d USB sticks: give one to a zone, or take it back"
        echo "       p<N> after a sleep, give zone N the passphrase its volume waits for"
        echo "Sound: c<N> let zone N use the microphone until it stops (c alone takes it back)"
        echo "       v<D> the volume, 0 to 9   v<N><D> zone N's own   x mute or unmute everything"
        echo "Camera: k<N> let zone N use it until its stop or the screen lock (k alone takes it back)"
        echo
        printf 'choice (e.g. 1t): '
        if ! read -r choice; then break; fi
        case "$choice" in
            q) break ;;
            u) run_update; continue ;;
            r|"") continue ;;
            w) run_wifi; continue ;;
            d) run_sticks; continue ;;
            f) if [ -r "$FOCUS_ZONE" ]; then
                   printf 'The last zone window you had: %s %s (zone %s)\n  %s\n' \
                       "$(sed -n 's/^glyph=//p' "$FOCUS_ZONE")" "$(sed -n 's/^label=//p' "$FOCUS_ZONE")" \
                       "$(sed -n 's/^zone=//p' "$FOCUS_ZONE")" "$(sed -n 's/^title=//p' "$FOCUS_ZONE")"
               else
                   echo "no zone window yet"
               fi
               sleep 3; continue ;;
            k) "$LAUNCH" --camera-revoke > /dev/null && echo "no zone has the camera now"
               sleep 1; continue ;;
            k[1-9]) idx="${choice#k}"; eval "z=\"\${Z$idx:-}\""
                    [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                    # The gesture is the grant: one zone at a time, until k, its stop or the lock.
                    "$LAUNCH" --camera-grant "$z" > /dev/null && echo "zone $z may use the camera until it stops, the screen locks, or k"
                    sleep 2; continue ;;
            c) "$SOUND" --control revoke > /dev/null && echo "no zone may record now"
               sleep 1; continue ;;
            c[1-9]) idx="${choice#c}"; eval "z=\"\${Z$idx:-}\""
                    [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                    # The gesture is the grant: one zone at a time, and the zone's stop ends it.
                    if "$SOUND" --control "grant $z" > /dev/null; then
                        echo "zone $z may use the microphone until it stops, or until c"
                    else
                        echo "the microphone was not granted (is the mixer running?)"
                    fi
                    sleep 1; continue ;;
            v[0-9]) "$SOUND" --control "volume $(( ${choice#v} * 100 / 9 ))" > /dev/null; continue ;;
            v[1-9][0-9]) a="${choice#v}"; d="${a#?}"; idx="${a%?}"; eval "z=\"\${Z$idx:-}\""
                    [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                    "$SOUND" --control "volume $z $(( d * 100 / 9 ))" > /dev/null; continue ;;
            x) "$SOUND" --control "mute toggle" > /dev/null; continue ;;
            m[1-9][1-9]) a="${choice#m}"; b="${a#?}"; a="${a%?}"
                      eval "za=\"\${Z$a:-}\""; eval "zb=\"\${Z$b:-}\""
                      [ -n "$za" ] && [ -n "$zb" ] || { echo "no such zones"; sleep 1; continue; }
                      echo "moving the clipboard of $za to $zb (this is the only way a payload crosses zones)"
                      "$LAUNCH" --clipboard-move "$za" "$zb" || sleep 2
                      sleep 1; continue ;;
            p[1-9]) idx="${choice#p}"; eval "z=\"\${Z$idx:-}\""
                      [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                      "$LAUNCH" --resume "$z" || sleep 2; sleep 1; continue ;;
            s[1-9]*) idx="${choice#s}"; eval "z=\"\${Z$idx:-}\""
                      [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                      "$LAUNCH" --stop "$z"; sleep 1; continue ;;
            [1-9]*[teb]) idx="${choice%?}"; app="${choice#"$idx"}"; eval "z=\"\${Z$idx:-}\""
                      [ -n "$z" ] || { echo "no zone $idx"; sleep 1; continue; }
                      case "$app" in
                          t) set -- "$TERMINAL" ;;
                          e) set -- "$TERMINAL" /usr/bin/nano ;;
                          b) set -- "$TERMINAL" /usr/bin/lynx ;;
                      esac
                      echo "launching in zone $z: $*"
                      # --ask: a passphrase is read on this zone 0 terminal, never a zone's.
                      "$LAUNCH" --ask "$z" -- "$@" || sleep 3
                      ;;
            *) echo "?"; sleep 1 ;;
        esac
    done
}

# --- USB sticks -----------------------------------------------------------------

# Whether the launch daemon lists a stick not offered yet while it stayed in: what it lists
# joins $seen, and what has left $SYS_BLOCK leaves it, so a stick given and taken back is not
# offered again until it is pulled out and plugged back. Listing also ends the grant of a stick
# pulled out.
sticks_new() {
    new=1 kept=""
    for p in $("$LAUNCH" --sticks 2>/dev/null | cut -d' ' -f1); do
        case " $seen " in *" $p "*) ;; *) new=0; seen="$seen $p" ;; esac
    done
    for p in $seen; do
        [ -e "$SYS_BLOCK/$p" ] && kept="$kept $p"
    done
    seen="$kept"
    return "$new"
}

# The zones a stick may go to: neither the net zone nor one whose file refuses sticks.
stick_zones() {
    for f in "$ZONES"/*.toml; do
        [ -f "$f" ] || continue
        z="$(basename "$f" .toml)"
        zone_is_nic "$z" && continue
        grep -q '^removable[[:space:]]*=[[:space:]]*false' "$f" && continue
        printf '%s\n' "$z"
    done
}

# The sticks held by no zone, lettered, and the zones that may take one, numbered: a letter and
# a number give that stick to that zone. kryptikd names a stick from sysfs, never from what its
# filesystem says.
run_sticks() {
    while :; do
        clear 2>/dev/null
        echo "================ KRYPTIK - USB sticks (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border. Zone 0 reads"
        echo "nothing on a stick: the zone you give it to does, with kryptik-stick in its"
        echo "terminal. Give a stick you do not know to untrusted."
        echo
        echo "Plugged in, held by no zone:"
        n=0
        for l in a b c d e f g h; do unset "S_$l"; done
        while read -r name what; do
            [ -n "$name" ] || continue
            n=$((n + 1))
            [ "$n" -le 8 ] || break
            l="$(echo abcdefgh | cut -c"$n")"
            eval "S_$l=\"\$name\""
            printf '  %s) %s\n' "$l" "$what"
        done <<EOF
$("$LAUNCH" --sticks 2>/dev/null)
EOF
        [ "$n" -gt 0 ] || echo "  none"
        echo
        echo "Zones that may take one:"
        k=0
        for z in $(stick_zones); do
            k=$((k + 1))
            [ "$k" -le 9 ] || break
            eval "T$k=\"\$z\""
            held="$("$LAUNCH" --info "$z" 2>/dev/null | sed -n 's/^stick //p')"
            case "$held" in
                "ro "*) held="holds ${held#ro }, to read (e$k)" ;;
                "rw "*) held="holds ${held#rw }, to read and write (e$k)" ;;
                *) held="" ;;
            esac
            printf '  %d) %-10s %-3s %-10s %s\n' "$k" "$z" "$(zone_field "$z" glyph)" "$(zone_field "$z" label)" "$held"
        done
        echo
        echo "a1 gives stick a to zone 1 to read; a1w lets it write too. e1 takes zone 1's back."
        echo "Nothing is given until you choose, and nothing is kept once the stick is out."
        printf 'choice (Enter closes): '
        read -r c || return 0
        case "$c" in
            "") return 0 ;;
            e[1-9]) eval "z=\"\${T${c#e}:-}\""
                    [ -n "$z" ] || { echo "no zone ${c#e}"; sleep 1; continue; }
                    "$LAUNCH" --stick-eject "$z" && echo "taken back: every read and write zone $z makes on it fails now" ;;
            [a-h][1-9]|[a-h][1-9]w)
                    l="${c%"${c#?}"}"; rest="${c#?}"; idx="${rest%w}"
                    eval "p=\"\${S_$l:-}\""; eval "z=\"\${T$idx:-}\""
                    [ -n "$p" ] && [ -n "$z" ] || { echo "no such stick or zone"; sleep 1; continue; }
                    mode=ro
                    [ "$rest" = "$idx" ] || mode=rw
                    "$LAUNCH" --stick-grant "$z" "$p" "$mode" > /dev/null &&
                        echo "zone $z has it until e$idx, its stop, or the stick coming out" ;;
            *) echo "?" ;;
        esac
        sleep 2
    done
}

# --- Wi-Fi ----------------------------------------------------------------------

# A scan's answer with the networks numbered; the lines about radios as they came.
heard_list() {   # heard_list SCAN
    printf '%s\n' "$1" | awk '/^"/ { printf "%2d %s\n", ++n, $0; next } { print "   " $0 }'
}
# The name of the Nth network a scan heard, from the daemon's quoted line, and on a second line
# its security as the line words it. A name with a backslash in that line holds a byte quoted so
# no terminal acts on it: it is typed instead.
heard_name() {   # heard_name SCAN N
    line="$(printf '%s\n' "$1" | grep '^"' | sed -n "${2}p" 2>/dev/null)"
    case "$line" in
        "" | *\\*) return 1 ;;
    esac
    line="${line#\"}"
    rest="${line#*\"  }"
    printf '%s\n%s\n' "${line%%\"*}" "${rest%%  *}"
}
# What a or o may save of the Nth network a scan heard: its name, or why not. Saved the other
# way, a network would never be joined, and an open one saved over a network's passphrase would
# lose the passphrase.
heard_pick() {   # heard_pick a|o SCAN N
    picked="$(heard_name "$2" "$3")" || { echo "the scan has no network $3 the menu can pass on by number: type its name"; return 1; }
    ssid="$(printf '%s\n' "$picked" | sed -n 1p)"
    kind="$(printf '%s\n' "$picked" | sed -n 2p)"
    case "$kind" in
        open) want=o ;;
        WPA | WPA2 | WPA3 | WPA2/WPA3) want=a ;;
        *) echo "network $ssid is $kind"; return 1 ;;
    esac
    if [ "$1" != "$want" ]; then
        if [ "$want" = o ]; then
            echo "network $ssid is open: o saves it"
        else
            echo "network $ssid is $kind: a saves it, with its passphrase"
        fi
        return 1
    fi
    printf '%s\n' "$ssid"
}

# The net zone's saved networks, through the launch daemon, as `kryptik wifi` has
# them at the administration login: kryptik-launch reads a passphrase here,
# unechoed, and the net zone restarts to join.
run_wifi() {
    # A number picks from a scan made in this window, never an earlier one.
    heard=""
    while :; do
        clear 2>/dev/null
        echo "================ KRYPTIK - Wi-Fi networks (zone 0) ================"
        echo "Saved networks:"
        nets="$("$LAUNCH" --wifi-list 2>&1)"
        printf '%s\n' "${nets:-none}" | sed 's/^/  /'
        echo
        echo "s the networks in range   a add, or change a passphrase   o add an open one"
        echo "f forget one   Enter back"
        printf 'choice: '
        read -r c || return 0
        case "$c" in
            "") return 0 ;;
            # The net zone scans every channel, which takes some seconds. Its answer is kept, so
            # a or o can take a network by its number.
            s) echo "asking the net zone what it hears..."
               heard="$("$LAUNCH" --wifi-scan 2>&1)"
               heard_list "$heard"
               printf 'Enter: back to the networks '
               read -r c || return 0 ;;
            # IFS=: an SSID may begin or end with a space.
            a|o|f) [ "$c" = o ] && echo "An open network has no passphrase: anyone in range reads what crosses it."
                   if [ "$c" != f ] && [ -n "${heard:-}" ]; then
                       printf 'network name (SSID), or its number from the scan: '
                   else
                       printf 'network name (SSID): '
                   fi
                   IFS= read -r ssid || return 0
                   [ -n "$ssid" ] || continue
                   case "$c:$ssid" in
                       [ao]:[1-9] | [ao]:[1-9][0-9])
                           if [ -n "${heard:-}" ]; then
                               ssid="$(heard_pick "$c" "$heard" "$ssid")" || { echo "$ssid"; sleep 3; continue; }
                               echo "network: $ssid"
                           fi ;;
                   esac
                   case "$c" in
                       a) "$LAUNCH" --wifi-add "$ssid" ;;
                       o) "$LAUNCH" --wifi-add-open "$ssid" ;;
                       f) "$LAUNCH" --wifi-forget "$ssid" ;;
                   esac
                   sleep 3 ;;
            *) echo "?"; sleep 1 ;;
        esac
    done
}

# --- the prompt -----------------------------------------------------------------

run_prompt() { # ZONE [--no-display] -- CMD...
    zone="$1"; shift
    nodisp=""
    [ "${1:-}" = "--no-display" ] && { nodisp="--no-display"; shift; }
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || die "--prompt: no command"
    [ -n "${WAYLAND_DISPLAY:-}" ] || die "--prompt: no display to draw the prompt on"
    # A trusted window holding only the question; kryptik-launch reads the
    # answer here and sends it as a descriptor.
    exec "$TERMINAL" /usr/bin/kryptik-launch --ask $nodisp "$zone" -- "$@"
}

run_confirm() { # ID
    id="$1"
    ask="$CONSENT/$id.ask"
    [ -r "$ask" ] || { echo "kryptik-chrome: no question $id (withdrawn?)"; sleep 2; exit 1; }
    # A question with no kind is a transfer.
    kind="$(sed -n 's/^kind=//p' "$ask")"
    if [ "$kind" = clock ]; then
        # The network's time is too far from this machine's to accept unasked (docs/design/time.md).
        now="$(sed -n 's/^now=//p' "$ask")"; proposed="$(sed -n 's/^proposed=//p' "$ask")"
        sources="$(sed -n 's/^sources=//p' "$ask")"
        echo "================ KRYPTIK - set the clock? (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo
        printf 'The network says it is   %s\n' "$proposed"
        printf 'This machine says it is  %s\n' "$now"
        printf '    (the median of %s time server(s), asked by the net zone, which is not trusted)\n' "$sources"
        echo
        echo "Check a watch or a phone. A wrong clock makes expired certificates"
        echo "look valid and old updates look new. Cancelling leaves the clock alone."
        echo
        echo "Set the clock to the network's time?"
    else
        from="$(sed -n 's/^from=//p' "$ask")"; to="$(sed -n 's/^to=//p' "$ask")"
        name="$(sed -n 's/^name=//p' "$ask")"; bytes="$(sed -n 's/^bytes=//p' "$ask")"
        echo "================ KRYPTIK - transfer request (zone 0) ================"
        echo "This window is drawn by the compositor with the unzoned border."
        echo
        printf 'Zone %s (%s) wants to send a file to zone %s (%s):\n' "$from" "$(zone_field "$from" label)" "$to" "$(zone_field "$to" label)"
        printf '    %s   (%s bytes)\n' "$name" "$bytes"
        echo
        echo "It will land in the receiving zone's incoming/ directory. Nothing else"
        echo "is shared. Cancelling leaves both zones as they are."
        echo
        echo "Allow this transfer?"
    fi
    # This window takes focus when it maps, so keys typed for another window,
    # a hostile zone's among them, may be waiting: after a second on screen
    # they are dropped, half-typed lines too, before any answer is read.
    sleep 1
    if [ -t 0 ] && was="$(stty -g)"; then
        stty -icanon min 0 time 0
        [ "$(cat | wc -c)" -eq 0 ] || echo "(what was typed before this question showed is ignored)"
        stty "$was"
    fi
    # Writes create, never follow or clobber: any member of group kryptik can plant a link.
    set -C
    # A code for this question alone: no zone sees this window, so none can type it.
    code=$(( $(od -An -N1 -tu1 /dev/urandom) % 90 + 10 ))
    # Kept for zone 0's tests; whatever can read it could write the answer anyway.
    (umask 077; printf '%s\n' "$code" > "$CONSENT/$id.code") 2>/dev/null \
        || echo "kryptik-chrome --confirm $id: the code could not be written beside the question" >> "$RT/kryptik/session.log"
    printf 'Type %s and Enter to allow; anything else refuses: ' "$code"
    answer=no
    if read -r reply; then
        [ "$reply" = "$code" ] && answer=yes
    fi
    # An answer that cannot be written is none: the broker takes that as a refusal.
    if printf '%s\n' "$answer" > "$CONSENT/$id.answer.tmp" && mv -f "$CONSENT/$id.answer.tmp" "$CONSENT/$id.answer"; then
        echo "-> $answer"
    else
        echo "-> the answer could not be recorded, which is a refusal"
    fi
    sleep 1
}

case "${1:-}" in
    "") run_status ;;
    --confirm) [ -n "${2:-}" ] || die "--confirm needs an id"; run_confirm "$2" ;;
    --menu) run_menu ;;
    --microphone) [ -n "${2:-}" ] || die "--microphone needs a zone"; run_microphone "$2" ;;
    --camera) [ -n "${2:-}" ] || die "--camera needs a zone"; run_camera "$2" ;;
    --battery) run_battery ;;
    --waiting) run_waiting ;;
    --sticks) run_sticks ;;
    --prompt) shift; run_prompt "$@" ;;
    --focus) cat "$FOCUS" 2>/dev/null || { echo "zone=-"; exit 1; } ;;
    *) die "usage: kryptik-chrome [--menu | --prompt ZONE [--no-display] -- CMD... | --focus | --microphone ZONE | --camera ZONE | --battery | --waiting | --sticks]" ;;
esac
