#!/bin/sh
# kryptik-session: the zoned desktop, exec'd by /etc/profile.d for a tty1 login.
# Runs as that user, never with privilege: anything that needs root, starting
# zones included, goes to the launch daemon through kryptik-launch. The user
# needs groups seat (seatd) and kryptik (the daemon); kryptik-firstboot grants both.

umask 077

if [ "$(id -u)" -eq 0 ]; then
    echo "kryptik-session: the desktop is an ordinary user's session, not root's" >&2
    exit 1
fi
# A degraded state partition (sysinit.sh) could keep nothing: say so and exit,
# which ends the login.
if [ -r /run/kryptik/state-degraded ]; then
    echo "kryptik-session: NOT starting the desktop: state is degraded ($(cat /run/kryptik/state-degraded))." >&2
    echo "kryptik-session: nothing would persist. Repair the state partition, or boot the install medium." >&2
    exit 1
fi

# No logind: the launch daemon creates /run/user/<uid> and says where it is.
if ! rt="$(/usr/bin/kryptik-launch --runtime-dir)"; then
    echo "kryptik-session: no runtime directory from the launch daemon" >&2
    echo "kryptik-session: is kryptikd-serve running, and is $(id -un) in group kryptik?" >&2
    exit 1
fi
case "$rt" in
    /*) ;;
    *) echo "kryptik-session: unusable runtime directory '$rt'" >&2; exit 1 ;;
esac

export XDG_RUNTIME_DIR="$rt"
export XDG_SESSION_TYPE=wayland
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# No WAYLAND_DISPLAY: wlroots would take it as a display to nest in. dwl names
# its own socket and exports it to the chrome.
unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY
# pixman is the only renderer built (s_wlroots), and wlroots picks it by itself
# only for a GPU without a render node.
export WLR_RENDERER=pixman
mkdir -p "$rt/kryptik" && chmod 0700 "$rt/kryptik"
log="$rt/kryptik/session.log"

{
    echo "kryptik-session: $(id -un) uid $(id -u) on $(tty 2>/dev/null || echo '?') at $(date -Iseconds 2>/dev/null || date)"
    for g in seat kryptik; do
        if ! id -Gn | tr ' ' '\n' | grep -qx "$g"; then
            echo "kryptik-session: WARNING: not in group $g - the desktop will not work fully"
        fi
    done
} >> "$log"

# dwl draws the zone borders (build/desktop/dwl-config.h) and pipes its status
# to the chrome, which shows the focused zone and is the launcher. When dwl
# exits, the login ends and tty1 returns to the login prompt.
exec /usr/bin/dwl -s /usr/bin/kryptik-chrome 2>> "$log"
