#!/bin/sh
# kryptik-session: the zoned desktop, exec'd by /etc/profile.d for a tty1 login, never as root.
# Anything that needs root, starting zones included, goes to the launch daemon (kryptik-launch).
# Needs groups seat (seatd) and kryptik (the launch daemon); kryptik-firstboot grants both.

umask 077

if [ "$(id -u)" -eq 0 ]; then
    echo "kryptik-session: the desktop is an ordinary user's session, not root's" >&2
    exit 1
fi
# A degraded state partition (sysinit.sh) keeps nothing: exit, which ends the login.
if [ -r /run/kryptik/state-degraded ]; then
    echo "kryptik-session: NOT starting the desktop: state is degraded ($(cat /run/kryptik/state-degraded))." >&2
    echo "kryptik-session: nothing would persist. Repair the state partition, or boot the install medium." >&2
    exit 1
fi

# No logind: the launch daemon creates /run/user/<uid> and says where it is.
if ! rt="$(/usr/bin/kryptik-launch --runtime-dir)"; then
    echo "kryptik-session: no runtime directory from the launch daemon" >&2
    echo "kryptik-session: is kryptikd-serve running, and is $(id -un) in group kryptik?" >&2
    exit 1
fi
case "$rt" in
    /*) ;;
    *) echo "kryptik-session: unusable runtime directory '$rt'" >&2; exit 1 ;;
esac

export XDG_RUNTIME_DIR="$rt"
export XDG_SESSION_TYPE=wayland
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# wlroots would nest in a set WAYLAND_DISPLAY; dwl names its own socket for the chrome.
unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY
# The layout sysinit loaded on the console, for dwl's xkb keymap; every zone's
# clients are handed the compositor's.
. /usr/libexec/kryptik/keyboard.sh
kb_export_xkb
# The user's own layouts, to switch among with Super+Space, in place of the machine's one.
kb_export_desktop "$XDG_CONFIG_HOME/kryptik/keyboard"
# pixman is the only renderer built (s_wlroots), and wlroots picks it by itself
# only for a GPU without a render node.
export WLR_RENDERER=pixman
# Cursor themes from the verified root alone: one looked for under the home directory
# would wait on the state partition while a suspend has it, and stall dwl at the prompt.
export XCURSOR_PATH=/usr/share/icons
# front holds the menu's requests to dwl, which may read and remove there alone.
mkdir -p "$rt/kryptik/front" && chmod 0700 "$rt/kryptik" "$rt/kryptik/front"
log="$rt/kryptik/session.log"
# The screen at the level the last brightness step left (brightness.sh), before anything shows.
/usr/libexec/kryptik/brightness.sh restore 2>> "$log" || :

{
    echo "kryptik-session: $(id -un) uid $(id -u) on $(tty 2>/dev/null || echo '?') at $(date -Iseconds 2>/dev/null || date)"
    # Group kryptik asks the launch daemon for everything; seat is dwl's, which the daemon gives it.
    if ! id -Gn | tr ' ' '\n' | grep -qx kryptik; then
        echo "kryptik-session: WARNING: not in group kryptik - the desktop will not work fully"
    fi
} >> "$log"

# dwl takes its seat through seatd, which s6 starts once udev has settled after boot, the GPU's
# driver bound: a login typed before then waits for it, up to settle's own 30 s.
i=0
[ -S /run/seatd.sock ] || echo "Waiting for the seat, up to 30 s: the devices are still settling after the boot."
while [ ! -S /run/seatd.sock ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
[ -S /run/seatd.sock ] || echo "kryptik-session: no seatd socket after ${i} s" >> "$log"

# dwl, which the launch daemon starts in group seat and without group kryptik, in the desktop's
# cgroup (its memory.max bounds what a zone can make the compositor hold), and the chrome on dwl's
# status, which this login's spawner starts with every group of the login; when dwl exits, or
# the daemon starts none, the login ends.
exec /usr/bin/kryptik-launch --desktop -- /usr/bin/kryptik-chrome 2>> "$log"
