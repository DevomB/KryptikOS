+/* Kryptik: the window at the output's scale. The buffer is the window's size times the scale,
+ * which the viewport shows at the window's size, so each pixel is one of the screen's; the
+ * cells that fit are drawn from a font that much larger, and what they leave is margin. At
+ * a scale of 1 it is upstream's, margin or not as the config says. */
+static void layout(void)
+{
+	bool scaled = term.scale != 120;
+	int w, h, col, row;
+	struct winsize ws;
+
+	term.confwidth = term.reqwidth ? term.reqwidth : logical(term.cfg.col * term.cwidth);
+	term.confheight = term.reqheight ? term.reqheight : logical(term.cfg.row * term.cheight);
+	w = (term.confwidth * term.scale + 60) / 120;
+	h = (term.confheight * term.scale + 60) / 120;
+	col = w / term.cwidth;
+	row = h / term.cheight;
+	ws = (struct winsize){ row, col, 0, 0 };
 
 	if (col == 0 || row == 0)
 		return;
 
-	if (term.width == term.confwidth && term.height == term.confheight)
-		return;
-
-	if (term.cfg.margin) {
-		term.width = term.confwidth;
-		term.height = term.confheight;
-		term.margin.left = (term.width - col * term.cwidth) / 2;
-		term.margin.top = (term.height - row * term.cheight) / 2;
-		term.need_redraw = true;
-		term.resize = 2;
-	} else {
+	if (term.cfg.margin || scaled) {
+		if (term.width != w || term.height != h || term.col != col || term.row != row) {
+			term.width = w;
+			term.height = h;
+			term.margin.left = (w - col * term.cwidth) / 2;
+			term.margin.top = (h - row * term.cheight) / 2;
+			term.need_redraw = true;
+			term.resize = 2;
+		}
+	} else if (term.width != col * term.cwidth || term.height != row * term.cheight) {
 		term.width = col * term.cwidth;
 		term.height = row * term.cheight;
+		term.margin.left = term.margin.top = 0;
+		term.need_redraw = true;
+		term.resize = 2;
+	}
+	if (term.viewport) {
+		if (scaled)
+			wp_viewport_set_destination(term.viewport, term.confwidth, term.confheight);
+		else
+			wp_viewport_set_destination(term.viewport, -1, -1);
 	}
 
 	if (term.col == col && term.row == row)
@@ -1558,6 +1589,30 @@
 	term.resize = 2;
 }
 
+static void configure(void *d, struct xdg_surface *surf, uint32_t serial)
+{
+	xdg_surface_ack_configure(surf, serial);
+	assert(!term.configured);
+	term.configured = true;
+	layout();
+}
+
+/* Kryptik: the output's scale, in 120ths, which the compositor tells as the window is shown
+ * and whenever it moves: the font is drawn that much larger, and layout() follows. */
+static void fscale_preferred(void *data, struct wp_fractional_scale_v1 *f, uint32_t scale)
+{
+	if (scale == 0 || scale > 120 * 8 || (int)scale == term.scale)
+		return;
+	term.scale = scale;
+	font_resize((term.cfg.font_size * term.scale + 60) / 120, &term.cwidth, &term.cheight);
+	if (term.configured)
+		layout();
+}
+
+static const struct wp_fractional_scale_v1_listener fscale_listener = {
+	.preferred_scale = fscale_preferred,
+};
+
 static const struct xdg_surface_listener surf_listener = {
 	.configure = configure,
 };
