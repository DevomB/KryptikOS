From 062f2f2581b991362c046f7f2e238ffa34e6f8c7 Mon Sep 17 00:00:00 2001
From: "Arnold D. Robbins" <arnold@skeeve.com>
Date: Sat, 4 Apr 2026 21:45:58 +0300
Subject: [PATCH] Minor integer overflow fixes.


Backported to gawk 5.3.0 (upstream 062f2f2581b991362c046f7f2e238ffa34e6f8c7): do_sub()'s
change as upstream; in parse_escape() 5.3.0 declares i as int, not long, and
it becomes int64_t as upstream's does. ChangeLog hunk dropped.
---
--- a/builtin.c
+++ b/builtin.c
@@ -2985,7 +2985,7 @@
 	char *repl;
 	char *replend;
 	size_t repllen;
-	int sofar;
+	size_t sofar;
 	int ampersands;
 	int matches = 0;
 	Regexp *rp;
--- a/node.c
+++ b/node.c
@@ -571,7 +571,7 @@
 	static char buf[MB_LEN_MAX];
 	enum escape_results retval = ESCAPE_OK;
 	int c = *(*string_ptr)++;
-	int i;
+	int64_t i;
 	int count;
 	int j;
 	const char *start;
