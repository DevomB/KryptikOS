# Pinned upstream package versions.
#
# ############################ VERSION STATUS ###############################
# All URLs below were confirmed to resolve upstream (HTTP 200) on 2026-09-10.
# They track the LFS 12.x series and are known-good, but NOT necessarily the
# newest upstream release. Run `tools/fetch-sources.sh --list` and re-check
# before a release build; security updates are your responsibility (ADR-001).
#
# Checksums are deliberately NOT stored here. They live in `sources.lock`,
# generated by `tools/fetch-sources.sh --lock` and audited against upstream
# signatures by a human. Never accept a lock file you did not audit.
# See docs/supply-chain.md.
# ###########################################################################

# --- toolchain ---
V_BINUTILS=2.43.1
V_GCC=14.2.0
V_GLIBC=2.40
V_LINUX=6.10.5

# --- gcc prerequisites ---
V_GMP=6.3.0
V_MPFR=4.2.1
V_MPC=1.3.1
V_ISL=0.27

# --- core userland ---
V_BASH=5.2.32
V_COREUTILS=9.5
V_SED=4.9
V_GREP=3.11
V_GAWK=5.3.0
V_FINDUTILS=4.10.0
V_DIFFUTILS=3.10
V_TAR=1.35
V_GZIP=1.13
V_XZ=5.6.2
V_ZLIB=1.3.1
V_ZSTD=1.5.6
V_FILE=5.45
V_MAKE=4.4.1
V_PATCH=2.7.6
V_M4=1.4.19
V_NCURSES=6.5
V_READLINE=8.2
V_UTIL_LINUX=2.40.2
V_E2FSPROGS=1.47.1
V_PKGCONF=2.3.0

# --- crypto / security ---
V_OPENSSL=3.3.1
V_CRYPTSETUP=2.7.5
V_LIBCAP=2.70
V_SHADOW=4.16.0

# --- language runtimes needed at build time ---
V_PYTHON=3.12.5
V_PERL=5.40.0

# --- kryptik-specific ---
V_HARDENED_MALLOC=12
V_LANDLOCK_HELPER=unset   # TBD, Phase 5

# --- mirrors ---
MIRROR_GNU="https://ftp.gnu.org/gnu"
MIRROR_KERNEL="https://cdn.kernel.org/pub/linux/kernel"
MIRROR_LFS="https://www.linuxfromscratch.org/lfs/downloads/stable"
