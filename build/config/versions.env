# Pinned upstream package versions.
#
# ############################ VERSION STATUS ###############################
# All URLs below were confirmed to resolve upstream (HTTP 200) on 2026-09-10.
# They track the LFS 12.x series and are known-good, but NOT necessarily the
# newest upstream release. Run `tools/fetch-sources.sh --list` and re-check
# before a release build; security updates are your responsibility (ADR-001).
#
# Checksums are deliberately NOT stored here. They live in `sources.lock`,
# generated by `tools/fetch-sources.sh --lock` and audited against upstream
# signatures by a human. Never accept a lock file you did not audit.
# See docs/supply-chain.md.
# ###########################################################################

# --- toolchain ---
V_BINUTILS=2.43.1
V_GCC=14.2.0
V_GLIBC=2.40
# LTS ONLY. A non-longterm kernel is EOL within ~2 months of release; see
# ADR-009. `make check-kernel-eol` enforces this against kernel.org.
V_LINUX=6.18.50
V_LINUX_HARDENED=6.18.50-hardened1
# Device firmware (ADR-012): kernel.org's dated linux-firmware release, signed
# by its maintainer (.tar.sign). build/config/firmware.list says which of its
# files ship; the rest of the 660 MB tarball is not unpacked into the image.
V_LINUX_FIRMWARE=20260916
# The regulatory database (regulatory.db and its signature, which cfg80211
# checks against a key built into the kernel): the wireless-regdb release,
# also kernel.org, also dated and signed.
V_WIRELESS_REGDB=2026.09.03
# Intel's CPU microcode release; AMD's comes with linux-firmware above. Both
# are built into the signed kernel by stage 05 (no initramfs to carry them).
# A GitHub archive of an unsigned tag: sources.lock is its provenance.
V_INTEL_MICROCODE=20260812

# --- gcc prerequisites ---
V_GMP=6.3.0
V_MPFR=4.2.1
V_MPC=1.3.1
V_ISL=0.27

# --- core userland ---
V_BASH=5.2.32
V_COREUTILS=9.5
V_SED=4.9
V_GREP=3.11
V_GAWK=5.3.0
V_FINDUTILS=4.10.0
V_DIFFUTILS=3.10
V_TAR=1.35
V_GZIP=1.13
# xz 5.6.0 and 5.6.1 shipped the CVE-2024-3094 backdoor. 5.6.2 removed it,
# but Kryptik pins well clear of that window rather than one patch past it -
# the incident was a build-system compromise, so proximity to it is not a
# quality Kryptik wants in its own build system. See docs/supply-chain.md.
V_XZ=5.8.4
V_ZLIB=1.3.1
V_ZSTD=1.5.6
V_FILE=5.45
V_MAKE=4.4.1
V_PATCH=2.7.6
V_M4=1.4.19
V_NCURSES=6.5
V_READLINE=8.2
V_UTIL_LINUX=2.40.2
V_E2FSPROGS=1.47.1
V_PKGCONF=2.3.0

# --- crypto / security ---
V_OPENSSL=3.5.8
V_CRYPTSETUP=2.8.8
V_LIBCAP=2.70
V_SHADOW=4.16.0

# --- compression / core libs ---
V_ZLIB_NG=2.2.1
V_BZIP2=1.0.8
V_ZSTD=1.5.6
V_EXPAT=2.6.2
V_LIBFFI=3.4.6
V_LIBXCRYPT=4.4.36

# --- build tooling needed inside the chroot ---
# Required by the KERNEL build, not by the userland: linux/Kbuild generates
# include/generated/timeconst.h with `bc -q`, and arch/x86 asm-offsets depends
# on that header, so stage 05 cannot start without it.
#
# 1.08.2 and not the 1.07.1 first proposed for it, on
# provenance's audit: 1.07.1's signature is SHA-1 and `gpg --weak-digest SHA1`
# rejects it outright, and its libmath patch is an `ed` script while Kryptik
# pins no ed - it would have traded the bc blocker for an ed blocker. 1.08.2 is
# signed SHA-512 and patches with sed, which is pinned.
V_BC=1.08.2
V_BISON=3.8.2
V_FLEX=2.6.4
V_GETTEXT=0.22.5
V_TEXINFO=7.1
V_AUTOCONF=2.72
V_AUTOMAKE=1.17
V_LIBTOOL=2.4.7
V_GPERF=3.1

# --- system utilities ---
V_ATTR=2.5.2
V_ACL=2.3.2
V_IANA_ETC=20240806
V_LESS=661
V_GROFF=1.23.0
V_PROCPS=4.0.4
V_PSMISC=23.7
V_INETUTILS=2.5
V_IPROUTE2=6.10.0
V_KBD=2.6.4
V_KMOD=33
V_LIBPIPELINE=1.5.7
V_GDBM=1.26
V_MANDB=2.12.1
V_ELFUTILS=0.191
V_EUDEV=3.2.14
V_GRUB=2.12

# --- init: s6 stack (ADR-006) ---
#
# CURRENT VERSIONS ONLY. skarnet publishes a .tar.gz.sha256 alongside each
# release but keeps only the current one, so an outdated pin is also an
# unverifiable pin. These are PID 1 and the service supervisor; the same
# reasoning that produced ADR-009 for the kernel applies here.
V_SKALIBS=2.15.1.0
V_EXECLINE=2.9.9.2
V_S6=2.15.1.0
V_S6_RC=0.7.0.0
V_S6_LINUX_INIT=1.2.0.2

# --- language runtimes needed at build time ---
V_PYTHON=3.12.5
V_PERL=5.40.0

# --- encrypted zone volumes: cryptsetup and what it needs ---
# cmake exists here only because json-c builds with nothing else; it is a
# build tool inside the chroot, like bison, and is not part of the image.
# The chroot runs Kitware's published Linux binary of this version (the
# cmake-bin manifest row, pinned in sources.lock like every other input)
# rather than compiling it: building cmake from source cost 13 of stage 04's
# 56 minutes on the runner, to generate one package's Makefiles. The source
# tarball stays in the manifest as the fallback for a chroot the binary
# cannot run in.
V_CMAKE=4.4.3
V_JSON_C=0.19-20260627
V_POPT=1.19
V_LIBAIO=0.3.113
# Only libdevmapper and dmsetup are built from LVM2 (make device-mapper).
V_LVM2=2.03.39

# --- release manifests are OpenSSH signatures; the installed system verifies
# them itself, so ssh-keygen is built and nothing else of OpenSSH.
V_OPENSSH=10.5p1

# --- the net zone: NAT and a resolver for routed zones, a DHCP client for
# the uplink (docs/design/net-zone.md).
V_LIBMNL=1.0.5
V_LIBNFTNL=1.3.2
V_NFTABLES=1.1.7
V_DNSMASQ=2.93
V_DHCPCD=10.5.2
# --- the net zone's wireless uplink: nl80211 through libnl, wpa_supplicant
# with its unix control interface (no D-Bus; wpa_cli beside it), iw for the
# operator. libnl's release tarball is signed (.sig), w1.fi's (.asc), iw's
# by kernel.org's convention (.tar.sign).
V_LIBNL=3.12.0
V_WPA_SUPPLICANT=2.12
V_IW=6.17
# What the net zone needs to ask the time and to fetch a release: chrony
# (chronyd -Q measures the offset and cannot set a clock; zone 0 decides what
# to do with the answer) and a CA bundle, Mozilla's as curl.se publishes it,
# dated, with a checksum the publisher states beside it.
V_CHRONY=4.9
V_CA_BUNDLE=2026-08-13

# --- the desktop: meson+ninja build the Wayland stack; dwl on
# wlroots (pixman renderer, no GPU stack) is the compositor engine; havoc is
# the terminal (embedded font, no freetype); lynx and nano are the browser
# and editor. dwl v0.8 builds against wlroots 0.19.x, which fixes that pin.
V_MESON=1.12.0
V_NINJA=1.13.2
V_WAYLAND=1.26.0
V_WAYLAND_PROTOCOLS=1.49
V_LIBXKBCOMMON=1.13.2
V_XKEYBOARD_CONFIG=2.48
V_PIXMAN=0.46.4
V_LIBDRM=2.4.129
V_LIBEVDEV=1.13.7
V_MTDEV=1.1.7
V_LIBINPUT=1.30.4
V_SEATD=0.9.3
V_HWDATA=0.411
V_LIBDISPLAY_INFO=0.4.0
V_WLROOTS=0.19.3
V_DWL=0.8
V_HAVOC=0.7.0
# The terminal's font (havoc renders from one TrueType file, named in its config).
V_DEJAVU_FONTS=2.37
V_LYNX=2.9.3
V_NANO=8.7

# --- kryptik-specific ---
# GrapheneOS signs hardened_malloc release tags; tools/verify-provenance.sh
# binds the archive to that signed tree, since the GitHub source archive
# itself is unsigned.
V_HARDENED_MALLOC=14
V_LANDLOCK_HELPER=unset   # not chosen yet

# --- build-time checks, not shipped ---
# kernel-hardening-checker (a13xp0p0v): the Kernel Self-Protection Project's
# reference list, run on the resolved kernel config and the shipped command
# line in stage 05 and in CI by tools/check-kernel-hardening.sh. A GitHub
# source archive of a lightweight tag: nothing upstream signs it, so
# sources.lock is its whole provenance (docs/supply-chain.md). Pure Python;
# runs from the tarball and is not part of the image.
V_KERNEL_HARDENING_CHECKER=0.6.17.1

# --- mirrors ---
# ftpmirror.gnu.org redirects to a nearby mirror; ftp.gnu.org itself is a
# frequent source of stalled transfers. Fallback is tried on failure.
MIRROR_GNU="https://ftpmirror.gnu.org"
MIRROR_GNU_FALLBACK="https://mirrors.kernel.org/gnu"
MIRROR_KERNEL="https://cdn.kernel.org/pub/linux/kernel"
MIRROR_LFS="https://www.linuxfromscratch.org/lfs/downloads/stable"
MIRROR_LFS_PATCHES="https://www.linuxfromscratch.org/patches/lfs/12.2"
MIRROR_HARDENED="https://github.com/anthraxx/linux-hardened/releases/download"
MIRROR_XZ="https://github.com/tukaani-project/xz/releases/download"
MIRROR_FILE="https://astron.com/pub/file"
MIRROR_SOURCEWARE="https://sourceware.org/pub"
MIRROR_SOURCEFORGE="https://downloads.sourceforge.net"
# libcap and e2fsprogs live under maintainer-specific kernel.org paths, not
# the generic /pub/linux/utils tree.
MIRROR_LIBCAP="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2"
MIRROR_E2FSPROGS="https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs"
MIRROR_KERNEL_UTILS="https://www.kernel.org/pub/linux/utils"
MIRROR_SKARNET="https://skarnet.org/software"
MIRROR_SAVANNAH="https://download.savannah.gnu.org/releases"
MIRROR_GITHUB="https://github.com"
MIRROR_FDO_GITLAB="https://gitlab.freedesktop.org"
MIRROR_FDO_SW="https://www.freedesktop.org/software"
MIRROR_DRI="https://dri.freedesktop.org/libdrm"
MIRROR_XORG="https://www.x.org/pub/individual"
MIRROR_CAIRO="https://www.cairographics.org/releases"
MIRROR_NETFILTER="https://www.netfilter.org/pub"
MIRROR_CMAKE="https://cmake.org/files"
MIRROR_PAGURE="https://releases.pagure.org"
MIRROR_OSUOSL_RPM="https://ftp.osuosl.org/pub/rpm"
MIRROR_OPENBSD="https://ftp.openbsd.org/pub/OpenBSD"
MIRROR_DICKEY="https://invisible-mirror.net/archives"
MIRROR_NANO="https://www.nano-editor.org/dist"
MIRROR_KELLEYS="https://thekelleys.org.uk/dnsmasq"
MIRROR_CODEBERG="https://codeberg.org"
MIRROR_SRHT="https://git.sr.ht"
MIRROR_BITMATH="https://bitmath.org/code/mtdev"
MIRROR_W1FI="https://w1.fi/releases"
MIRROR_CHRONY="https://chrony-project.org/releases"
MIRROR_CURL_CA="https://curl.se/ca"
MIRROR_KERNEL_SOFTWARE="https://www.kernel.org/pub/software"
