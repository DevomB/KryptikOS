# Pinned upstream package versions.
#
# ############################ VERSION STATUS ###############################
# All URLs below were confirmed to resolve upstream (HTTP 200) on 2026-09-10.
# They track the LFS 12.x series and are known-good, but NOT necessarily the
# newest upstream release. Run `tools/fetch-sources.sh --list` and re-check
# before a release build; security updates are your responsibility (ADR-001).
#
# Checksums are deliberately NOT stored here. They live in `sources.lock`,
# generated by `tools/fetch-sources.sh --lock` and audited against upstream
# signatures by a human. Never accept a lock file you did not audit.
# See docs/supply-chain.md.
# ###########################################################################

# --- toolchain ---
V_BINUTILS=2.43.1
V_GCC=14.2.0
V_GLIBC=2.40
# LTS ONLY. A non-longterm kernel is EOL within ~2 months of release; see
# ADR-009. `make check-kernel-eol` enforces this against kernel.org.
V_LINUX=6.18.50
V_LINUX_HARDENED=6.18.50-hardened1

# --- gcc prerequisites ---
V_GMP=6.3.0
V_MPFR=4.2.1
V_MPC=1.3.1
V_ISL=0.27

# --- core userland ---
V_BASH=5.2.32
V_COREUTILS=9.5
V_SED=4.9
V_GREP=3.11
V_GAWK=5.3.0
V_FINDUTILS=4.10.0
V_DIFFUTILS=3.10
V_TAR=1.35
V_GZIP=1.13
# xz 5.6.0 and 5.6.1 shipped the CVE-2024-3094 backdoor. 5.6.2 removed it,
# but Kryptik pins well clear of that window rather than one patch past it -
# the incident was a build-system compromise, so proximity to it is not a
# quality Kryptik wants in its own build system. See docs/supply-chain.md.
V_XZ=5.8.4
V_ZLIB=1.3.1
V_ZSTD=1.5.6
V_FILE=5.45
V_MAKE=4.4.1
V_PATCH=2.7.6
V_M4=1.4.19
V_NCURSES=6.5
V_READLINE=8.2
V_UTIL_LINUX=2.40.2
V_E2FSPROGS=1.47.1
V_PKGCONF=2.3.0

# --- crypto / security ---
V_OPENSSL=3.3.1
V_CRYPTSETUP=2.7.5
V_LIBCAP=2.70
V_SHADOW=4.16.0

# --- compression / core libs ---
V_ZLIB_NG=2.2.1
V_BZIP2=1.0.8
V_ZSTD=1.5.6
V_EXPAT=2.6.2
V_LIBFFI=3.4.6
V_LIBXCRYPT=4.4.36

# --- build tooling needed inside the chroot ---
V_BISON=3.8.2
V_FLEX=2.6.4
V_GETTEXT=0.22.5
V_TEXINFO=7.1
V_AUTOCONF=2.72
V_AUTOMAKE=1.17
V_LIBTOOL=2.4.7
V_GPERF=3.1

# --- system utilities ---
V_ATTR=2.5.2
V_ACL=2.3.2
V_IANA_ETC=20240806
V_LESS=661
V_GROFF=1.23.0
V_PROCPS=4.0.4
V_PSMISC=23.7
V_INETUTILS=2.5
V_IPROUTE2=6.10.0
V_KBD=2.6.4
V_KMOD=33
V_LIBPIPELINE=1.5.7
V_MANDB=2.12.1
V_ELFUTILS=0.191
V_EUDEV=3.2.14
V_GRUB=2.12

# --- init: s6 stack (ADR-006) ---
V_SKALIBS=2.14.1.1
V_EXECLINE=2.9.5.1
V_S6=2.12.0.4
V_S6_RC=0.5.4.2
V_S6_LINUX_INIT=1.1.2.0

# --- language runtimes needed at build time ---
V_PYTHON=3.12.5
V_PERL=5.40.0

# --- kryptik-specific ---
V_HARDENED_MALLOC=12
V_LANDLOCK_HELPER=unset   # TBD, Phase 5

# --- mirrors ---
# ftpmirror.gnu.org redirects to a nearby mirror; ftp.gnu.org itself is a
# frequent source of stalled transfers. Fallback is tried on failure.
MIRROR_GNU="https://ftpmirror.gnu.org"
MIRROR_GNU_FALLBACK="https://mirrors.kernel.org/gnu"
MIRROR_KERNEL="https://cdn.kernel.org/pub/linux/kernel"
MIRROR_LFS="https://www.linuxfromscratch.org/lfs/downloads/stable"
MIRROR_LFS_PATCHES="https://www.linuxfromscratch.org/patches/lfs/12.2"
MIRROR_HARDENED="https://github.com/anthraxx/linux-hardened/releases/download"
MIRROR_XZ="https://github.com/tukaani-project/xz/releases/download"
MIRROR_FILE="https://astron.com/pub/file"
MIRROR_SOURCEWARE="https://sourceware.org/pub"
MIRROR_SOURCEFORGE="https://downloads.sourceforge.net"
# libcap and e2fsprogs live under maintainer-specific kernel.org paths, not
# the generic /pub/linux/utils tree.
MIRROR_LIBCAP="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2"
MIRROR_E2FSPROGS="https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs"
MIRROR_KERNEL_UTILS="https://www.kernel.org/pub/linux/utils"
MIRROR_SKARNET="https://skarnet.org/software"
MIRROR_SAVANNAH="https://download.savannah.gnu.org/releases"
MIRROR_GITHUB="https://github.com"
