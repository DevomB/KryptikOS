# Pinned upstream versions: known to build, not necessarily the newest. Check
# them before a release (tools/fetch-sources.sh --list); security updates are
# ours to track (ADR-001). Checksums are in sources.lock, which is audited
# against upstream signatures before it is accepted (docs/supply-chain.md).

# --- toolchain ---
V_BINUTILS=2.43.1
V_GCC=14.4.0
V_GLIBC=2.40
# Longterm kernels only (ADR-009); `make check-kernel-eol` enforces it.
V_LINUX=6.18.50
V_LINUX_HARDENED=6.18.50-hardened1
# Device firmware (ADR-012); build/config/firmware.list picks what ships.
V_LINUX_FIRMWARE=20260916
# regulatory.db, whose signature cfg80211 checks against a key in the kernel.
V_WIRELESS_REGDB=2026.09.03
# Intel CPU microcode (AMD's is in linux-firmware), built into the kernel by
# stage 05. An unsigned tag's archive: sources.lock is its only provenance.
V_INTEL_MICROCODE=20260812

# --- gcc prerequisites ---
V_GMP=6.3.0
V_MPFR=4.2.2
V_MPC=1.3.1

# --- core userland ---
V_BASH=5.2.32
V_COREUTILS=9.12
V_SED=4.10
V_GREP=3.11
V_GAWK=5.3.0
V_FINDUTILS=4.11.0
V_DIFFUTILS=3.10
V_TAR=1.35
V_GZIP=1.13
# Clear of the backdoored 5.6.0/5.6.1 (CVE-2024-3094, docs/supply-chain.md).
V_XZ=5.8.4
V_ZLIB=1.3.1
V_FILE=5.45
V_MAKE=4.4.1
V_PATCH=2.8
V_M4=1.4.19
V_NCURSES=6.6
V_READLINE=8.2
V_UTIL_LINUX=2.42.3
V_E2FSPROGS=1.47.1
V_PKGCONF=2.3.0

# --- crypto / security ---
V_OPENSSL=3.5.8
V_CRYPTSETUP=2.8.8
V_LIBCAP=2.78
V_SHADOW=4.16.0

# --- compression / core libs ---
V_BZIP2=1.0.8
V_ZSTD=1.5.6
V_EXPAT=2.8.4
V_LIBFFI=3.5.2
V_LIBXCRYPT=4.5.2

# --- build tooling needed inside the chroot ---
# bc is for the kernel build, which generates timeconst.h with `bc -q`. Not
# 1.07.1: its SHA-1 signature is rejected by gpg, and it patches with ed.
V_BC=1.08.2
V_BISON=3.8.2
V_FLEX=2.6.4
V_GETTEXT=0.22.5
V_TEXINFO=7.1
V_LIBTOOL=2.4.7
V_GPERF=3.1

# --- system utilities ---
V_ATTR=2.6.0
V_ACL=2.3.2
V_IANA_ETC=20240806
V_LESS=710
V_GROFF=1.23.0
V_PROCPS=4.0.7
V_PSMISC=23.7
V_INETUTILS=2.8
V_IPROUTE2=7.2.0
V_KBD=2.10.0
V_KMOD=34.2
V_LIBPIPELINE=1.5.7
V_GDBM=1.26
V_MANDB=2.12.1
V_ELFUTILS=0.191
V_EUDEV=3.2.14

# --- init: s6 stack (ADR-006) ---
# Current releases only: skarnet keeps a .sha256 for the current release alone,
# so an outdated pin cannot be verified.
V_SKALIBS=2.15.1.0
V_EXECLINE=2.9.9.2
V_S6=2.15.1.0
V_S6_RC=0.7.0.0
V_S6_LINUX_INIT=1.2.0.2

# --- language runtimes needed at build time ---
V_PYTHON=3.12.14
V_PERL=5.40.5

# --- encrypted zone volumes: cryptsetup and what it needs ---
# cmake only builds json-c and is not in the image. The chroot runs Kitware's
# binary (cmake-bin in sources.lock) to save a long source build; the source
# tarball is the fallback where that binary cannot run.
V_CMAKE=4.4.3
V_JSON_C=0.19-20260627
V_POPT=1.19
V_LIBAIO=0.3.113
# Only libdevmapper and dmsetup are built from LVM2 (make device-mapper).
V_LVM2=2.03.42

# --- release signatures: only ssh-keygen is built from OpenSSH ---
V_OPENSSH=10.5p1

# --- the net zone: NAT, a resolver and DHCP (docs/design/net-zone.md) ---
V_LIBMNL=1.0.5
V_LIBNFTNL=1.3.2
V_NFTABLES=1.1.7
V_DNSMASQ=2.93
V_DHCPCD=10.5.2
# --- the net zone's Wi-Fi: libnl, wpa_supplicant (no D-Bus) and iw ---
V_LIBNL=3.12.0
V_WPA_SUPPLICANT=2.12
V_IW=6.17
# Mozilla's CA bundle as curl.se publishes it: how the net zone checks a
# release server.
V_CA_BUNDLE=2026-08-13

# --- the desktop ---
# dwl on wlroots (pixman renderer, no GPU stack), havoc, lynx and nano.
# dwl 0.8 builds against wlroots 0.19.x, which fixes that pin.
V_MESON=1.12.0
V_NINJA=1.13.2
V_WAYLAND=1.26.0
V_WAYLAND_PROTOCOLS=1.49
V_LIBXKBCOMMON=1.13.2
V_XKEYBOARD_CONFIG=2.48
V_PIXMAN=0.46.4
V_LIBDRM=2.4.129
V_LIBEVDEV=1.13.7
V_MTDEV=1.1.7
V_LIBINPUT=1.30.4
V_SEATD=0.9.3
V_HWDATA=0.411
V_LIBDISPLAY_INFO=0.4.0
V_WLROOTS=0.19.3
V_DWL=0.8
V_HAVOC=0.7.0
# havoc's font: it renders from one TrueType file.
V_DEJAVU_FONTS=2.37
V_LYNX=2.9.3
V_NANO=9.2

# --- kryptik-specific ---
# GrapheneOS signs the release tags; tools/verify-provenance.sh ties the
# unsigned GitHub archive to the signed tree.
V_HARDENED_MALLOC=14

# --- build-time checks, not shipped ---
# kernel-hardening-checker, run by tools/check-kernel-hardening.sh in stage 05
# and CI. Nothing upstream signs it: sources.lock is its only provenance.
V_KERNEL_HARDENING_CHECKER=0.6.17.1

# --- mirrors ---
# ftpmirror.gnu.org picks a nearby mirror; the fallback is used on failure.
MIRROR_GNU="https://ftpmirror.gnu.org"
MIRROR_GNU_FALLBACK="https://mirrors.kernel.org/gnu"
MIRROR_KERNEL="https://cdn.kernel.org/pub/linux/kernel"
MIRROR_LFS="https://www.linuxfromscratch.org/lfs/downloads/stable"
MIRROR_LFS_PATCHES="https://www.linuxfromscratch.org/patches/lfs/12.2"
MIRROR_HARDENED="https://github.com/anthraxx/linux-hardened/releases/download"
MIRROR_XZ="https://github.com/tukaani-project/xz/releases/download"
MIRROR_FILE="https://astron.com/pub/file"
MIRROR_SOURCEWARE="https://sourceware.org/pub"
MIRROR_SOURCEFORGE="https://downloads.sourceforge.net"
# libcap and e2fsprogs live under maintainer paths, not /pub/linux/utils.
MIRROR_LIBCAP="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2"
MIRROR_E2FSPROGS="https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs"
MIRROR_KERNEL_UTILS="https://www.kernel.org/pub/linux/utils"
MIRROR_SKARNET="https://skarnet.org/software"
MIRROR_SAVANNAH="https://download.savannah.gnu.org/releases"
MIRROR_GITHUB="https://github.com"
MIRROR_FDO_GITLAB="https://gitlab.freedesktop.org"
MIRROR_FDO_SW="https://www.freedesktop.org/software"
MIRROR_DRI="https://dri.freedesktop.org/libdrm"
MIRROR_XORG="https://www.x.org/pub/individual"
MIRROR_CAIRO="https://www.cairographics.org/releases"
MIRROR_NETFILTER="https://www.netfilter.org/pub"
MIRROR_CMAKE="https://cmake.org/files"
MIRROR_PAGURE="https://releases.pagure.org"
MIRROR_OSUOSL_RPM="https://ftp.osuosl.org/pub/rpm"
MIRROR_OPENBSD="https://ftp.openbsd.org/pub/OpenBSD"
MIRROR_DICKEY="https://invisible-mirror.net/archives"
MIRROR_NANO="https://www.nano-editor.org/dist"
MIRROR_KELLEYS="https://thekelleys.org.uk/dnsmasq"
MIRROR_CODEBERG="https://codeberg.org"
MIRROR_SRHT="https://git.sr.ht"
MIRROR_BITMATH="https://bitmath.org/code/mtdev"
MIRROR_W1FI="https://w1.fi/releases"
MIRROR_CURL_CA="https://curl.se/ca"
MIRROR_KERNEL_SOFTWARE="https://www.kernel.org/pub/software"
