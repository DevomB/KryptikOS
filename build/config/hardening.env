# Hardening flags for the target packages; docs/hardening.md has the reasons.
# Loaded by stage 04 only: stages 01 and 02 build the compiler that implements
# these flags, and set no flags at all.

# No -fPIE or -pie: GCC is built with --enable-default-pie, so executables are
# PIE anyway, and -pie links Scrt1.o into shared libraries, which then fail on
# an undefined main.

# _FORTIFY_SOURCE needs -O1 or more; -O2 is the tested level.
KRYPTIK_OPT="-O2"

KRYPTIK_CFLAGS_HARDENING="\
-D_FORTIFY_SOURCE=3 \
-fstack-protector-strong \
-fstack-clash-protection \
-fcf-protection=full \
-ftrivial-auto-var-init=zero \
-fno-delete-null-pointer-checks \
-fno-strict-aliasing"

KRYPTIK_LDFLAGS_HARDENING="\
-Wl,-z,relro \
-Wl,-z,now \
-Wl,-z,noexecstack \
-Wl,-z,separate-code \
-Wl,--as-needed"

export CFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export CXXFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export LDFLAGS="${KRYPTIK_LDFLAGS_HARDENING}"

# Packages exempted from some flags. Each needs a justification, which
# validate_hardening_exceptions in build/lib/common.sh enforces.
KRYPTIK_HARDENING_EXCEPTIONS="build/config/hardening-exceptions.txt"
