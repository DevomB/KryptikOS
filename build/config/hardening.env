# Kryptik toolchain hardening flags
# Rationale for every flag: docs/hardening.md
#
# NOT applied during toolchain bootstrap (stage 01 pass 1) — the compiler that
# implements these flags cannot be built with them. Stage 01 sources this file
# only for pass 2 onward.

# NOTE ON PIE: neither -fPIE nor -pie appears below, and that is deliberate.
#
# Kryptik's GCC is configured --enable-default-pie (stages 01 and 02), so
# executables are position-independent WITHOUT either flag. Verified:
#
#   gcc <hardening flags, no -pie> -o exe exe.c
#   readelf -h exe  ->  Type: DYN (Position-Independent Executable file)
#   readelf -d exe  ->  FLAGS_1: NOW PIE
#
# So they bought nothing. They also broke every shared library in the
# distribution: -pie makes the linker pull in Scrt1.o, the executable startup
# object, which references main(). A .so has no main, so the link dies with
#
#   ld: Scrt1.o: in function `_start`: undefined reference to `main`
#
# Python was simply the first package in the build order to produce a .so.
# Every library after it would have failed identically, and "add a hardening
# exception per package" would have meant an exception for nearly all of them.
# The flags were wrong, not the packages.

# Optimization level. _FORTIFY_SOURCE requires >= -O1; -O2 is the tested path.
KRYPTIK_OPT="-O2"

KRYPTIK_CFLAGS_HARDENING="\
-D_FORTIFY_SOURCE=3 \
-fstack-protector-strong \
-fstack-clash-protection \
-fcf-protection=full \
-ftrivial-auto-var-init=zero \
-fno-delete-null-pointer-checks \
-fno-strict-aliasing"

KRYPTIK_LDFLAGS_HARDENING="\
-Wl,-z,relro \
-Wl,-z,now \
-Wl,-z,noexecstack \
-Wl,-z,separate-code \
-Wl,--as-needed"

# C++ gets the same treatment.
export CFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export CXXFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export LDFLAGS="${KRYPTIK_LDFLAGS_HARDENING}"

# Packages that genuinely break under the full set. Every entry requires a
# justification; build/lib/common.sh rejects undocumented exceptions.
KRYPTIK_HARDENING_EXCEPTIONS="build/config/hardening-exceptions.txt"
