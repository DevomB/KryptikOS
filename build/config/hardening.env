# Hardening flags for the target packages, loaded by stage 04; docs/hardening.md has the reasons.

# No -fPIE or -pie: GCC defaults to PIE, and -pie breaks shared libraries (Scrt1.o, undefined main).

# _FORTIFY_SOURCE needs -O1 or more; -O2 is the tested level.
KRYPTIK_OPT="-O2"

KRYPTIK_CFLAGS_HARDENING="\
-D_FORTIFY_SOURCE=3 \
-fstack-protector-strong \
-fstack-clash-protection \
-fcf-protection=full \
-ftrivial-auto-var-init=zero \
-fno-delete-null-pointer-checks \
-fno-strict-aliasing"

KRYPTIK_LDFLAGS_HARDENING="\
-Wl,-z,relro \
-Wl,-z,now \
-Wl,-z,noexecstack \
-Wl,-z,separate-code \
-Wl,--as-needed"

export CFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export CXXFLAGS="${KRYPTIK_OPT} ${KRYPTIK_CFLAGS_HARDENING}"
export LDFLAGS="${KRYPTIK_LDFLAGS_HARDENING}"

# Per-package flag exemptions, each with the justification validate_hardening_exceptions enforces.
KRYPTIK_HARDENING_EXCEPTIONS="build/config/hardening-exceptions.txt"
