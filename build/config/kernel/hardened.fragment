# Options that exist only with the linux-hardened patchset (ADR-009): against an
# unpatched tree every line is dropped silently, so stage 05 patches first.
# Check with `make validate-kernel-hardened`; reasons in docs/hardening.md.

# --- heap hardening ---
# Slab canaries, and checks that sanitization really happened.
CONFIG_SLAB_CANARY=y
CONFIG_SLAB_SANITIZE_VERIFY=y
CONFIG_PAGE_SANITIZE_VERIFY=y

# --- terminal injection ---
# TIOCSTI injects input into a terminal, a sandbox escape wherever a confined
# process shares a tty with a shell; zones share none with zone 0 anyway.
CONFIG_SECURITY_TIOCSTI_RESTRICT=y

# --- perf ---
# perf_event_open has a long record of privilege escalations, and nothing here
# needs unprivileged profiling.
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y

# --- unprivileged namespaces ---
# Unprivileged user namespaces expose root-only kernel surface to any process.
# Zones (ADR-002) are created by the privileged kryptikd, and nothing in a zone
# creates a namespace. Nested zones would need this on, and an ADR of their own.
# CONFIG_USER_NS_UNPRIVILEGED is not set

# kryptikd mounts the overlays of ephemeral zones; zones never do.
# CONFIG_OVERLAY_FS_UNPRIVILEGED is not set

# --- memory corruption detection ---
CONFIG_KFENCE_BUG_ON_DATA_CORRUPTION=y

# --- network ---
# TCP simultaneous connect: rarely used, and a known attack surface.
# CONFIG_TCP_SIMULT_CONNECT_DEFAULT_ON is not set
