# Kryptik kernel boot fragment: what firmware boot, the verified root, the
# update mechanism and the desktop need from the kernel
# (docs/design/boot-and-updates.md). Merged after hardening.fragment;
# validated by make validate-kernel-boot.
#
# WHAT MAY BE BUILT IN
#
# There is no initramfs, so a driver is built in (=y) only when one of these
# is true, and the line or its section says which:
#
#   1. it is needed to find, verify and mount the root: EFI, dm-verity, the
#      storage controllers and the buses they sit on, the filesystems;
#   2. it gives a console and a keyboard before the root is mounted, so a
#      boot that fails can be read and answered: the firmware framebuffer,
#      fbcon, the PS/2, USB and paravirtual keyboards;
#   3. it cannot do its job as a module: netfilter for the net zone (a
#      request for a module from inside a user namespace is refused), CPU
#      microcode (it must load before anything runs), the watchdog (the
#      path that recovers a hung machine must not depend on module
#      loading), and a few platform drivers every distribution keeps built
#      in because devices behind them misbehave when they arrive late.
#
# Everything else is a module (=m). Modules are signed by this build and an
# unsigned one does not load (MODULE_SIG_FORCE); eudev loads them by
# modalias at coldplug, from the verified root, before any service that
# wants the device starts. A network card, a GPU, a touchpad or a radio is
# never needed before the root is mounted, so none of them is built in -
# including the virtual machine's, on purpose: the acceptance suite then
# boots through the same autoload path real hardware depends on, instead of
# a shortcut only the test machine has.
#
# Until the image carried modules the rule was "everything is =y", and the
# signed kernel went from 17.8 MB to 31.6 MB when hardware support was
# widened under it. Stage 05 now prints what the image is made of and
# refuses one larger than build/config/kernel/size-budget says.

# --- the kernel is the UEFI application ---
# The EFI stub boots the kernel with no bootloader. EFI_MIXED (32-bit
# firmware) is off: Kryptik is x86_64 only and a smaller stub is a smaller
# signed surface.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# CONFIG_EFI_MIXED is not set
CONFIG_EFI_PARTITION=y
# The update tool arms a one-shot BootNext and reads/writes Boot#### through
# efivarfs; without it the A/B trial has no firmware-side state.
CONFIG_EFIVAR_FS=y

# --- the command line is part of the signed image ---
# CMDLINE_OVERRIDE is the load-bearing option: the firmware's load options
# and any Boot#### optional data are ignored, so root=, init= and
# dm-mod.create= cannot be changed without re-signing the kernel. The value
# here is a placeholder; stage 06 relinks the kernel once per boot variant
# with the real command line (root slot, verity root hash, salt).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="kryptik.unbound=1"
CONFIG_CMDLINE_OVERRIDE=y

# --- the verified root, without an initramfs ---
# dm-init builds the dm-verity (and, for the ISO, dm-linear) device from
# dm-mod.create= before root is mounted. Devices are named PARTLABEL=...;
# early_lookup_bdev resolves those. No initramfs means nothing unsigned runs
# before the verified root.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
# The ESP is FAT; the installer and updater mount it from userspace.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# /etc is an overlay on the state partition; zone volumes are LUKS2 files
# opened through loop devices.
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

# --- a console and a keyboard before the root; the desktop after it ---
# simpledrm takes over the firmware framebuffer on every UEFI machine, the
# test VM included, and fbcon draws on it: that is the console a failed
# boot is read on. A native driver (virtio-gpu in the QEMU tests; i915, xe
# or amdgpu on hardware) is a module and replaces it at coldplug, before
# anyone can log in. The compositor renders with pixman, so no GPU
# acceleration is needed or assumed. Keyboards are built in; pointing
# devices are modules.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- the net zone: NAT and a resolver for routed zones ---
# Netfilter is built in because the net zone loads its ruleset from inside a
# user namespace, and the kernel refuses to autoload a module on behalf of
# one: as modules these would simply be missing the first time they were
# asked for. The network cards are modules; the net zone starts after
# coldplug has loaded them.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_VIRTIO_NET=m
CONFIG_E1000=m
CONFIG_E1000E=m

# --- real hardware ---
# There is no initramfs, so the controller the verified root sits on has to
# be built in or the kernel waits for a disk it cannot see; so are the USB
# host controllers, for a root on a stick and for the keyboard. The rest are
# modules. The set below is what a download is expected to meet: NVMe and
# SAS controllers, the Intel, Broadcom and Realtek wired adapters of
# servers, desktops and docks, the two BMC framebuffers, and USB 2 as well
# as 3. None of this has been booted on physical hardware yet; the first
# machine that does will say what is missing. Stage 05 fails if any line
# here does not survive olddefconfig.
CONFIG_BLK_DEV_NVME=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_ATA_PIIX=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_TIGON3=m
CONFIG_BNXT=m
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m
# Intel laptops and desktops from the 11th generation on ship with the NVMe
# drive behind VMD ("RAID" or "Intel RST" in the firmware setup); without
# the VMD driver the drive does not exist. Cheap laptops and mini PCs boot
# from eMMC on an SDHCI controller. USB 3 sticks and enclosures speak UAS.
# HPE servers put their disks behind Smart Array (hpsa, smartpqi).
CONFIG_VMD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_USB_UAS=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_SMARTPQI=y
# USB 1.1 companions: on a machine without xHCI, a USB keyboard or mouse
# (low and full speed) is handed from EHCI to UHCI or OHCI, and without
# those drivers the desktop has no keyboard.
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
# Laptop touchpads and touchscreens are HID devices on an I2C bus: the
# DesignWare I2C controller, reached through Intel LPSS or the AMD
# platform device, its GPIO interrupt through the SoC's pin controller.
# Modules, with three exceptions that other distributions also keep built
# in: AMD's pin controller, and the DesignWare core and its platform glue,
# because ACPI methods on some laptops talk to devices behind them during
# boot and fail for good if the controller is not there yet.
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_LAKEFIELD=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_INTEL_PLATFORM=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
# Wired adapters beyond the above: Aquantia/Marvell AQtion (the 5 and 10
# gigabit ports on desktop boards and Thunderbolt docks) and Mellanox
# ConnectX-4 onward in servers. Neither needs a firmware file.
CONFIG_AQTION=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
# Virtual machines other than QEMU/KVM. VMware: paravirtual SCSI and
# network, its display and its mouse. Hyper-V: the VMBus devices a
# generation 2 VM has. Hyper-V's firmware trusts only Microsoft's keys, so
# Kryptik boots there with Secure Boot turned off in the VM's settings.
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=m
CONFIG_DRM_VMWGFX=m
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=m
CONFIG_DRM_HYPERV=m

# --- CPU microcode ---
# The early loader applies an update before anything else runs, and with no
# initramfs the only place it can find one is inside the kernel. Stage 05
# builds every file of Intel's release and AMD's containers in
# (CONFIG_EXTRA_FIRMWARE; the stage sets it, because its value is a list of
# files that changes with each release, and checks it survived like a line
# here). Late loading stays off: an update applied under running zones is
# not something to allow for convenience.
CONFIG_MICROCODE=y
# CONFIG_MICROCODE_LATE_LOADING is not set

# --- drivers that need firmware: modules, so the verified root can supply it
# A built-in driver probes while the bus is enumerated, before root is
# mounted, and a request_firmware() then finds nothing: an amdgpu or
# iwlwifi compiled in would fail once and stay failed. As modules they are
# loaded by eudev after sysinit, when /lib/firmware is there, and only
# with the signature this build put on them (MODULE_SIG_FORCE). The files
# they load come from the pinned linux-firmware release, selected by
# build/config/firmware.list, and live on the dm-verity root like every
# other byte the kernel executes. Firmware is compressed with zstd there;
# the loader knows to look for name.zst.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Display: Intel (i915 for Gen 9 to Meteor Lake, xe from Lunar Lake and
# Battlemage) and AMD. i915 was built in by the x86_64 defconfig; it is a
# module now for the same reason as the others, and simpledrm carries the
# console until it loads. NVIDIA stays on simpledrm: nouveau's GSP firmware
# is tens of megabytes per generation and the compositor needs no
# acceleration.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
# Wireless. cfg80211 and mac80211 are built in (defconfig); the drivers are
# modules: Intel (every generation since 7260, including the recent
# Wi-Fi 7 parts under iwlmld), Qualcomm Atheros (QCA6174 and QCA9377 on
# ath10k, QCA6390 and WCN6855 on ath11k, WCN7850 on ath12k), MediaTek
# (MT7921, MT7922, MT7925), Realtek (the 8822/8821/8723 family on rtw88,
# the 8852/8851/8922 family on rtw89), Broadcom (brcmfmac over PCIe: Dell
# and Apple machines) and the Realtek USB sticks (rtl8xxxu). mac80211_hwsim
# is a virtual radio: the integrity suite loads its signed copy and refuses
# an unsigned one, and the net zone's wiphy move is tested against it.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_RTL8XXXU=m
CONFIG_MAC80211_HWSIM=m

# --- built in by the upstream default configuration, and not needed there ---
# x86_64_defconfig predates this fragment's rule and builds these in. The
# wireless stack is only ever used by the radio modules above, and as a
# module cfg80211 reads the regulatory database from the verified root
# instead of asking for it before there is one. The older wired adapters
# and the vendor HID quirks load by modalias like everything else.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_E100=m
CONFIG_SKY2=m
CONFIG_FORCEDETH=m
CONFIG_8139TOO=m
CONFIG_PHYLIB=m
CONFIG_REALTEK_PHY=m
CONFIG_HID_A4TECH=m
CONFIG_HID_APPLE=m
CONFIG_HID_BELKIN=m
CONFIG_HID_CHERRY=m
CONFIG_HID_CHICONY=m
CONFIG_HID_CYPRESS=m
CONFIG_HID_EZKEY=m
CONFIG_HID_GYRATION=m
CONFIG_HID_ITE=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_REDRAGON=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MONTEREY=m
CONFIG_HID_NTRIG=m
CONFIG_HID_PANTHERLORD=m
CONFIG_HID_PETALYNX=m
CONFIG_HID_SAMSUNG=m
CONFIG_HID_SONY=m
CONFIG_HID_SUNPLUS=m
CONFIG_HID_TOPSEED=m

# --- how the image is compressed ---
# The default is gzip. zstd at the level the kernel build uses is smaller
# and decompresses faster, and the build already has zstd for the firmware.
# It does nothing for the microcode, which is encrypted and does not
# compress; that half of the image is the size it is.
CONFIG_KERNEL_ZSTD=y
# CONFIG_KERNEL_GZIP is not set
