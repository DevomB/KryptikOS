# What firmware boot, the verified root, updates and the desktop need from the
# kernel (docs/design/boot-and-updates.md). Merged after hardening.fragment;
# check with `make validate-kernel-boot`.
# With no initramfs, a driver is built in (ADR-013) only to find, verify or
# mount the root, to give a console and keyboard before it, or where a module
# cannot work (netfilter, microcode, the watchdog, some platform drivers).
# Everything else is a signed module loaded by eudev at coldplug, the test VM's
# network and display included. Stage 05 fails an image over size-budget.

# --- the kernel is the UEFI application ---
# The EFI stub boots the kernel without a bootloader. No EFI_MIXED (32-bit
# firmware): x86_64 only, and a smaller signed stub.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# CONFIG_EFI_MIXED is not set
CONFIG_EFI_PARTITION=y
# efivarfs, for the updater's BootNext and Boot#### entries (the A/B trial).
CONFIG_EFIVAR_FS=y

# --- the command line is part of the signed image ---
# CMDLINE_OVERRIDE ignores the firmware's load options and Boot#### data, so
# root=, init= and dm-mod.create= cannot change without re-signing. The value
# is a placeholder: stage 06 relinks each boot variant with its real line.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="kryptik.unbound=1"
CONFIG_CMDLINE_OVERRIDE=y

# --- the verified root, without an initramfs ---
# dm-init builds the dm-verity (and for the ISO, dm-linear) device from
# dm-mod.create= (devices by PARTLABEL=), so no unsigned initramfs is needed.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
# The ESP is FAT; the installer and updater mount it from userspace.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# The /etc overlay, and zone volumes: LUKS2 files on loop devices.
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

# --- a console and a keyboard before the root; the desktop after it ---
# simpledrm and fbcon on the firmware framebuffer are the console a failed boot
# is read on; the native GPU driver, a module, replaces them at coldplug. The
# compositor renders with pixman, so no acceleration is needed. Keyboards are
# built in, pointing devices are modules.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- the net zone: NAT and a resolver for routed zones ---
# Netfilter is built in: the net zone loads its ruleset from a user namespace,
# for which the kernel will not autoload modules. Network cards are modules,
# loaded at coldplug before the net zone starts.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_VIRTIO_NET=m
CONFIG_E1000=m
CONFIG_E1000E=m

# --- real hardware ---
# Storage controllers a root can sit on, and USB host controllers (a root on a
# stick, the keyboard), are built in, or the kernel waits for a disk it cannot
# see; the rest are modules. Not yet booted on physical hardware.
CONFIG_BLK_DEV_NVME=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_ATA_PIIX=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_TIGON3=m
CONFIG_BNXT=m
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m
# VMD: from Intel's 11th generation the NVMe drive sits behind it ("RAID" or
# "Intel RST" in setup). eMMC on SDHCI: cheap laptops and mini PCs. UAS: USB 3
# sticks. hpsa and smartpqi: HPE Smart Array.
CONFIG_VMD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_USB_UAS=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_SMARTPQI=y
# USB 1.1 companions: without xHCI, EHCI hands a USB keyboard or mouse to them.
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
# Touchpads and touchscreens: HID over DesignWare I2C (Intel LPSS or the AMD
# platform device), interrupts via the pin controller. Modules, except AMD's pin
# controller and the DesignWare core and platform glue: some laptops' ACPI uses
# them during boot and fails for good if they are not there yet.
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_LAKEFIELD=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_INTEL_PLATFORM=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
# AQtion (5 and 10 GbE on desktop boards and Thunderbolt docks) and Mellanox
# ConnectX-4 and later (servers); neither needs firmware.
CONFIG_AQTION=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
# VMware and Hyper-V (generation 2) guests. Hyper-V's firmware trusts only
# Microsoft's keys, so Secure Boot must be off in the VM's settings.
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=m
CONFIG_DRM_VMWGFX=m
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=m
CONFIG_DRM_HYPERV=m

# --- CPU microcode ---
# With no initramfs the early loader finds microcode only inside the kernel;
# stage 05 sets CONFIG_EXTRA_FIRMWARE. No late loading under running zones.
CONFIG_MICROCODE=y
# CONFIG_MICROCODE_LATE_LOADING is not set

# --- drivers that need firmware: modules, so the verified root can supply it
# Built in, they would probe before root is mounted and fail for good in
# request_firmware(). The files (build/config/firmware.list) are stored zstd
# compressed on the dm-verity root.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Display: i915 (Gen 9 to Meteor Lake), xe (Lunar Lake, Battlemage), amdgpu.
# NVIDIA stays on simpledrm: nouveau's GSP firmware is tens of MB a generation.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
# Wi-Fi drivers: Intel (7260 on, Wi-Fi 7 under iwlmld), Qualcomm Atheros,
# MediaTek, Realtek (rtw88, rtw89, USB rtl8xxxu) and Broadcom over PCIe.
# mac80211_hwsim is a virtual radio for the integrity suite (signed copy loads,
# unsigned refused) and the net zone's wiphy move test.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_RTL8XXXU=m
CONFIG_MAC80211_HWSIM=m

# --- built in by defconfig, needed only as modules --------------------------
# As a module, cfg80211 reads the regulatory database from the verified root
# instead of asking before there is one; the rest load by modalias.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_E100=m
CONFIG_SKY2=m
CONFIG_FORCEDETH=m
CONFIG_8139TOO=m
CONFIG_PHYLIB=m
CONFIG_REALTEK_PHY=m
CONFIG_HID_A4TECH=m
CONFIG_HID_APPLE=m
CONFIG_HID_BELKIN=m
CONFIG_HID_CHERRY=m
CONFIG_HID_CHICONY=m
CONFIG_HID_CYPRESS=m
CONFIG_HID_EZKEY=m
CONFIG_HID_GYRATION=m
CONFIG_HID_ITE=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_REDRAGON=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MONTEREY=m
CONFIG_HID_NTRIG=m
CONFIG_HID_PANTHERLORD=m
CONFIG_HID_PETALYNX=m
CONFIG_HID_SAMSUNG=m
CONFIG_HID_SONY=m
CONFIG_HID_SUNPLUS=m
CONFIG_HID_TOPSEED=m

# --- image compression ---
# zstd: smaller than gzip and faster to decompress. The microcode is encrypted
# and does not compress.
CONFIG_KERNEL_ZSTD=y
# CONFIG_KERNEL_GZIP is not set
# --- a machine that has stopped reboots itself -------------------------------
# build/services/watchdog feeds these. Built in, so recovery does not depend on
# module loading. NOWAYOUT: killing the feeder does not stop the timer.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_SYSFS=y
# The software watchdog covers a hung userspace on any machine, but not a hung
# kernel: the hard lockup detector panics then, and panic=10 reboots.
CONFIG_SOFT_WATCHDOG=y
# Hardware timers catch a hung kernel: Intel TCO (behind LPC or SMBus, named as
# EXPERT drops those selects), AMD SP5100, and QEMU's i6300esb for tests.
CONFIG_LPC_ICH=y
CONFIG_I2C_I801=y
CONFIG_ITCO_WDT=y
CONFIG_ITCO_VENDOR_SUPPORT=y
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y
# A hard lockup (interrupts off for 10 s) panics: that CPU does not come back.
# Soft lockups and hung tasks only report: they are often stalls that end (a
# GPU reset, slow storage, a descheduled vCPU), and a false reboot is worse.
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
