# Kryptik kernel hardening fragment
# Merge with: scripts/kconfig/merge_config.sh .config hardening.fragment
# Rationale: docs/hardening.md
# Verify with: kernel-hardening-checker -c .config
# Validate symbols exist in the pinned kernel: make validate-kernel

# --- memory ---
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_VMAP_STACK=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- compiler-enforced ---
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_ZERO_CALL_USED_REGS=y

# NOT SET: CONFIG_CFI / CONFIG_CFI_CLANG.
# Kernel Control Flow Integrity requires the kernel to be built with Clang
# (it depends on CC_IS_CLANG). Kryptik's toolchain is GCC, so setting it here
# would be dropped for an unmet dependency and the fragment would be claiming
# a mitigation the kernel does not have. In 6.18 CONFIG_CFI_CLANG is also
# marked 'transitional' - the live symbol is CONFIG_CFI.
#
# Building the kernel with Clang while userspace stays GCC is a legitimate
# split (Android does exactly this) and would buy CFI plus better sanitizer
# coverage. Deferred to a Phase 4 evaluation rather than decided here.

# --- kernel memory protection ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STATIC_USERMODEHELPER=y

# --- module signing: unsigned modules must not load ---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# --- lockdown: severs root's path to kernel memory ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# --- required by the zone model (docs/architecture.md) ---
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_OVERLAY_FS=y

# --- yama / ptrace ---
CONFIG_SECURITY_YAMA=y

# --- attack surface removal ---
# CONFIG_DEVMEM is not set
# (CONFIG_DEVKMEM removed upstream in 5.13 - /dev/kmem support is gone)
# CONFIG_LEGACY_PTYS is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_IA32_EMULATION is not set

# --- debug interfaces that leak kernel state ---
# CONFIG_DEBUG_FS is not set
# (CONFIG_DEBUG_CREDENTIALS removed upstream in 6.5)
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- BPF: a well-worn LPE path ---
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- speculative execution mitigations ---
# These moved under a MITIGATION_ prefix in 6.9. The pre-6.9 spellings
# (CONFIG_RETPOLINE, CONFIG_SLS) are silently ignored by merge_config.sh,
# which would leave the kernel without them while the fragment still claimed
# otherwise. Validated by tools/validate-kernel-config.sh.
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_UNRET_ENTRY=y

# --- misc ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_GCC_PLUGIN_RANDSTRUCT=y

# Stack variable initialization. The GCC_PLUGIN_STRUCTLEAK_* options were
# removed upstream once compilers gained -ftrivial-auto-var-init; INIT_STACK_
# ALL_ZERO is the current spelling and matches the -ftrivial-auto-var-init=zero
# Kryptik already applies to userspace (build/config/hardening.env).
CONFIG_INIT_STACK_ALL_ZERO=y
