# Kernel hardening in vanilla Linux symbols (docs/hardening.md). Check the
# symbols with `make validate-kernel`; kernel-hardening-checker findings are
# fixed here or accepted, with a reason, in checker-accepted.txt.

# --- memory ---
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_VMAP_STACK=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- compiler-enforced ---
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_ZERO_CALL_USED_REGS=y

# No kernel CFI: it needs a Clang-built kernel (CC_IS_CLANG) and the toolchain
# is GCC. A Clang kernel with GCC userspace, as Android builds, is not
# evaluated yet.

# --- kernel memory protection ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STATIC_USERMODEHELPER=y

# --- module signing: unsigned modules must not load ---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# --- lockdown: severs root's path to kernel memory ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# --- required by the zone model (docs/architecture.md) ---
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
# (No CGROUP_BPF: it needs bpf(), which is off; see BPF below.)
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_OVERLAY_FS=y

# --- yama / ptrace ---
CONFIG_SECURITY_YAMA=y

# --- attack surface removal ---
# CONFIG_DEVMEM is not set
# (DEVKMEM is gone upstream since 5.13.)
# CONFIG_LEGACY_PTYS is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_IA32_EMULATION is not set

# --- debug interfaces that leak kernel state ---
# debugfs exposes kernel internals that lockdown does not fully close off.
# CONFIG_DEBUG_FS is not set
# defconfig's blktrace selects DEBUG_FS back on, and nothing here uses it.
# CONFIG_BLK_DEV_IO_TRACE is not set
# (DEBUG_CREDENTIALS is gone upstream since 6.5.)
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- BPF: not built ---
# Nothing loads a BPF program (seccomp filters are classic BPF and need no
# bpf()), and the verifier is a common source of privilege escalations.
# CONFIG_BPF_SYSCALL is not set

# --- speculative execution mitigations ---
# The MITIGATION_ names date from 6.9; the old spellings (RETPOLINE, SLS) would
# be dropped silently.
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_UNRET_ENTRY=y

# --- misc ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y

# Stack erasing (KSTACK_ERASE, STACKLEAK before 6.17) and structure layout
# randomization. GCC_PLUGIN_STACKLEAK and GCC_PLUGIN_RANDSTRUCT still exist but
# are derived from these, so a fragment cannot set them.
CONFIG_KSTACK_ERASE=y
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
CONFIG_RANDSTRUCT_FULL=y

# Zero-initialized stack variables, like -ftrivial-auto-var-init=zero in
# userspace (build/config/hardening.env). Replaces GCC_PLUGIN_STRUCTLEAK_*.
CONFIG_INIT_STACK_ALL_ZERO=y

# securityfs, so /sys/kernel/security/lsm shows which LSMs are active. The LSMs
# themselves work without it.
CONFIG_SECURITYFS=y

# --- zones and encrypted storage --------------------------------------------

# SIT gives every network namespace a sit0 tunnel device, so a zone with
# network.mode = "none" would have more than the loopback it promises.
# CONFIG_IPV6_SIT is not set

# aes-xts-plain64, the cipher of standard LUKS2 volumes, for dm-crypt.
CONFIG_CRYPTO_XTS=y

# No fscrypt: zone volumes and the state partition are dm-crypt (LUKS2).
# CONFIG_FS_ENCRYPTION is not set

# --- kernel-hardening-checker recommendations (see checker-accepted.txt) -----

# Several options below have prompts only `if EXPERT`; without it their
# "is not set" lines are ignored and they stay y. EXPERT itself changes nothing.
CONFIG_EXPERT=y

# Self-protection.
CONFIG_DEBUG_VIRTUAL=y
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_TRAP=y
# With UBSAN_TRAP a finding is a panic, so only the bounds check stays on; the
# others fire on conditions the kernel tolerates. The checker asks for this set.
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_INTEGER_WRAP is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set
CONFIG_SCHED_CORE=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_TRIM_UNUSED_KSYMS=y
# The EFI stub stops PCI bus mastering before ExitBootServices, so no device can
# DMA over the kernel as it starts. The firmware wipes RAM, which holds the zone
# volume keys, on the next reset (MemoryOverwriteRequestControl); every reboot
# pays for that in POST time.
CONFIG_EFI_DISABLE_PCI_DMA=y
CONFIG_RESET_ATTACK_MITIGATION=y
# IOMMU on and strict from boot: a Thunderbolt or PCIe device gets only the
# mappings its driver asked for. The checker also asks for Intel SVM.
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_INTEL_IOMMU_SVM=y
# The TPM, as an entropy source.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y

# /proc/pid/mem cannot write through read-only mappings, even for a ptracer;
# shadow stacks for userspace built with -fcf-protection (hardening.env).
CONFIG_PROC_MEM_NO_FORCE=y
CONFIG_X86_USER_SHADOW_STACK=y

# /proc/config.gz, to check a running kernel against its intended config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Attack surface with no use here. No SELinux (ADR-007 chose Landlock and
# seccomp), and the LSM list is the three that are built.
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="landlock,lockdown,yama"
# CONFIG_X86_MSR is not set
# CONFIG_X86_CPUID is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_IO_URING is not set
# CONFIG_RSEQ is not set
# CONFIG_CACHESTAT_SYSCALL is not set
# CONFIG_PROVIDE_OHCI1394_DMA_INIT is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KALLSYMS_ALL is not set
# Nothing writes a mounted block device: the updater writes the unmounted slot,
# the installer an unmounted disk, and zone volumes go through dm-crypt.
# CONFIG_BLK_DEV_WRITE_MOUNTED is not set
# kernel.core_pattern is already |/bin/false; no core dump support at all.
# CONFIG_COREDUMP is not set
# /proc/pid/{pagemap,smaps,clear_refs}: physical layout leaks, unused here.
# CONFIG_PROC_PAGE_MONITOR is not set

# --- built in by defconfig, used by nothing here: off, not modules ----------
# Each is reachable from a device, a packet or a mount: no audio stack, no
# network filesystem, buses no UEFI x86-64 machine has (CardBus, AGP, Mac), no
# RAID under the dm-verity slots, and msdos is vfat with shorter names.
# CONFIG_SOUND is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NET_9P is not set
# CONFIG_PCCARD is not set
# CONFIG_AGP is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# (Not MD itself: device-mapper, and so dm-verity, lives under it.)
# CONFIG_BLK_DEV_MD is not set
# CONFIG_DM_MIRROR is not set
# CONFIG_DM_ZERO is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_MON is not set
# CONFIG_PROFILING is not set
# CONFIG_SERIAL_NONSTANDARD is not set
# CONFIG_HW_RANDOM_VIA is not set
# CONFIG_EEEPC_LAPTOP is not set
# CONFIG_QUOTA is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_MSDOS_FS is not set
# Conntrack helpers parse FTP, IRC and SIP payloads in the kernel, fed by any
# peer, for protocols the net zone does not need. netconsole would put the
# kernel log one module parameter away from leaving the machine.
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_CONNTRACK_IRC is not set
# CONFIG_NF_CONNTRACK_SIP is not set
# CONFIG_NETCONSOLE is not set
