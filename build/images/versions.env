# Pins of the software images' sources (build/images), apart from the root's in
# build/config/versions.env: they never reach the root, so a change here is no
# input of stage 04 and leaves its cache standing. Their checksums are in
# build/images/sources.lock; tools/fetch-sources.sh lists them per image.

MIRROR_GNOME="https://download.gnome.org/sources"
# Savannah's own copy: the redirector can send a new release to a mirror that lacks it yet.
MIRROR_SAVANNAH_MASTER="https://download-mirror.savannah.gnu.org/releases"
MIRROR_ICON_THEME="https://icon-theme.freedesktop.org/releases"

# --- toolkit: GTK 3 for Wayland alone, without X11 or D-Bus ---
V_PCRE2=10.49
V_GLIB=2.90.1
V_LIBPNG=1.6.59
V_FREETYPE=2.15.0
V_HARFBUZZ=14.6.0
V_FONTCONFIG=2.18.3
V_FRIBIDI=1.0.17
V_CAIRO=1.18.6
V_PANGO=1.58.2
V_GDK_PIXBUF=2.44.8
# Its Khronos EGL headers alone, which libepoxy and GTK compile against; the root has no EGL.
V_LIBGLVND=1.7.0
V_LIBEPOXY=1.5.10
# ATK, which GTK 3 requires, is built from here without the D-Bus bridge.
V_AT_SPI2_CORE=2.62.1
V_HICOLOR_ICON_THEME=0.18
V_GTK3=3.24.52
