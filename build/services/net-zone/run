#!/bin/sh
# The net zone, sole holder of the physical NICs: every interface on a bus
# device (`nic = "*"`, kryptikd's netzone::physical_interfaces). Ephemeral, so
# no --passphrase-file. Waits for such an interface rather than failing in a
# restart loop: drivers are modules, and a radio or a dock can appear later.
have_nic() {
    for d in /sys/class/net/*; do
        case "${d##*/}" in lo) continue ;; esac
        [ -e "$d/device" ] && return 0
    done
    return 1
}
if ! have_nic; then
    echo "net-zone: no physical network interface yet; waiting for one"
    while ! have_nic; do sleep 5; done
    # Let sibling interfaces finish probing, so they leave zone 0 too.
    sleep 3
    echo "net-zone: an interface has appeared"
fi
# --ready-fd: nobody waits to hear that the zone is up, but with it the launcher
# keeps this service's log and hands the zone a pipe. Each line the zone
# writes is then marked as its own and cannot pass for the launcher's or a
# zone 0 service's, its control bytes are replaced, and a megabyte a start is
# the most it logs (spawn.rs, ZoneOutput). A zone that says more goes unlogged
# until its next start; filling the allowance again by the hour is the way on
# if that proves too little.
exec /usr/bin/kryptikd run net --zones /usr/lib/kryptik/zones --rootfs /var/lib/kryptik/zones \
     --ready-fd 3 -- /usr/libexec/kryptik/netzone-init.sh 3>/dev/null
