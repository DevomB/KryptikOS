#!/bin/sh
# Install media get a root shell here as on serial: whoever installs may be at either.
if grep -qE '(^| )kryptik\.media=[a-z]+( |$)' /proc/cmdline 2>/dev/null; then
    exec /usr/sbin/agetty -n -l /usr/bin/bash --noclear tty1 linux
fi
# A login; the user's profile starts the desktop session.
exec /usr/sbin/agetty --noclear tty1 linux
