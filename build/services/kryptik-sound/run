#!/bin/sh
# Zone 0's mixer (docs/design/laptop.md), as uid 87 in group audio (11), which opens the cards:
# fixed numbers, so no account needs a line under /etc. Each zone with sound gets a directory
# that root owns and the mixer's group writes; kryptikd binds it into the zone, and the mixer,
# which cannot replace it, makes the zone's socket in it. The control socket's directory is
# setgid kryptik, the session's group: no zone has a path to it.
d=/run/kryptik-sound
install -d -m 0755 "$d" "$d/zones" || exit 1
install -d -m 2750 -o 87 -g kryptik "$d/control" || exit 1
/usr/bin/kryptikd sound zones --zones /usr/lib/kryptik/zones > "$d/zones.list" || exit 1
while read -r name _; do
    install -d -m 0775 -g 11 "$d/zones/$name" || exit 1
done < "$d/zones.list"
exec s6-applyuidgid -u 87 -g 11 -G 11 /usr/libexec/kryptik/kryptik-sound "$d/zones.list"
